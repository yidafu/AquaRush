# Admin Favorites Input Types
input AdminFavoriteListInput {
  page: Int = 0
  size: Int = 20
  userId: PrimaryId
  productId: PrimaryId
  dateFrom: LocalDateTime
  dateTo: LocalDateTime
  sortBy: FavoriteSortBy! = CREATED_AT_DESC
  search: String
  productStatus: ProductStatus
}

enum FavoriteSortBy {
  CREATED_AT_ASC
  CREATED_AT_DESC
  USER_ID_ASC
  USER_ID_DESC
  PRODUCT_ID_ASC
  PRODUCT_ID_DESC
  PRODUCT_NAME_ASC
  PRODUCT_NAME_DESC
  PRODUCT_PRICE_ASC
  PRODUCT_PRICE_DESC
}

input BatchFavoriteOperationInput {
  userIds: [PrimaryId!]!
    @size(min: 1, max: 1000, message: "用户ID数量应在1-1000之间")
  productIds: [PrimaryId!]!
    @size(min: 1, max: 1000, message: "商品ID数量应在1-1000之间")
  operation: BatchFavoriteOperation!
  reason: String @size(max: 500, message: "操作原因长度不能超过500个字符")
}

enum BatchFavoriteOperation {
  CLEAR_ALL_FAVORITES
  CLEAR_SPECIFIC_PRODUCTS
  EXPORT_FAVORITES
  ANALYZE_FAVORITES
}

input ExportFavoritesInput {
  userId: PrimaryId
  productIds: [PrimaryId!]
  dateFrom: LocalDateTime
  dateTo: LocalDateTime
  format: ExportFormat! = CSV
  includeUserInfo: Boolean! = true
  includeProductInfo: Boolean! = true
}

enum ExportFormat {
  CSV
  EXCEL
  JSON
}

type BatchOperationResult {
  success: Boolean!
  message: String!
  processedCount: Int!
  successCount: Int!
  failureCount: Int!
  errors: [String!]!
  details: Map!
}

type ExportFavoritesResult {
  success: Boolean!
  message: String!
  downloadUrl: String
  fileName: String!
  fileSize: Long!
  recordCount: Int!
  expiresAt: LocalDateTime!
}

input ProductListInput {
  page: Int = 0
  size: Int = 20
  sort: String = "createdAt,desc"
  search: String
  status: ProductStatus
  minPrice: Money
    @positive(message: "最小价格必须为正数")
    @min(value: 1, message: "最小价格不能小于1分")
    @max(value: 9999900, message: "最小价格不能大于99999元")
  maxPrice: Money
    @positive(message: "最大价格必须为正数")
    @min(value: 1, message: "最大价格不能小于1分")
    @max(value: 9999900, message: "最大价格不能大于99999元")
  minStock: Int @min(value: 0, message: "最小库存不能小于0")
  maxStock: Int @min(value: 0, message: "最大库存不能小于0")
}

input ProductUpdateRequest {
  id: PrimaryId! @positive(message: "商品ID必须为正数")
  name: String
    @size(min: 2, max: 200, message: "商品名称长度应在2-200个字符之间")
  subtitle: String @size(max: 500, message: "商品副标题长度不能超过500个字符")
  price: Money
    @positive(message: "商品价格必须为正数")
    @min(value: 1, message: "商品价格不能小于1分")
    @max(value: 9999900, message: "商品价格不能大于99999元")
  originalPrice: Money
    @positive(message: "原价必须为正数")
    @min(value: 1, message: "原价不能小于1分")
    @max(value: 9999900, message: "原价不能大于99999元")
  depositPrice: Money
    @min(value: 0, message: "押金不能小于0")
    @max(value: 9999900, message: "押金不能大于99999元")
  coverImageUrl: String
    @size(max: 500, message: "封面图片URL长度不能超过500个字符")
  imageGallery: JsonArray
    @size(max: 2000, message: "图片画廊URL长度不能超过2000个字符")
  specification: String
    @size(min: 1, max: 100, message: "商品规格长度应在1-100个字符之间")
  waterSource: String @size(max: 200, message: "水源地长度不能超过200个字符")

  mineralContent: String
    @size(max: 200, message: "矿物质含量长度不能超过200个字符")
  stock: Int
    @min(value: 0, message: "库存数量不能小于0")
    @max(value: 99999, message: "库存数量不能大于99999")
  salesVolume: Int @min(value: 0, message: "销量不能小于0")
  status: ProductStatus
  sortOrder: Int
    @min(value: 0, message: "排序权重不能小于0")
    @max(value: 9999, message: "排序权重不能大于9999")
  tags: JsonArray
  detailContent: String
    @size(max: 5000, message: "详情内容长度不能超过5000个字符")
  certificateImages: JsonArray
  deliverySettings: JsonObject
}

# Enhanced Product Management Types

type WaterSourceStatistics {
  waterSource: String!
  productCount: Int!
  totalSalesVolume: Int!
  averagePrice: Money!
}

type SpecificationStatistics {
  specification: String!
  productCount: Int!
  totalSalesVolume: Int!
  averagePrice: Money!
}

type SalesReport {
  dateRange: DateRange!
  totalSales: Int!
  totalRevenue: Money!
  topSellingProducts: [ProductSalesInfo!]!
  salesByWaterSource: [WaterSourceStatistics!]!
  salesBySpecification: [SpecificationStatistics!]!
}

type ProductSalesInfo {
  product: Product!
  salesVolume: Int!
  revenue: Money!
  salesPercentage: Float!
}

input SalesReportInput {
  dateRange: DateRangeInput!
  groupBy: SalesReportGroupBy! = DAY
  includeWaterSourceBreakdown: Boolean! = true
  includeSpecificationBreakdown: Boolean! = true
  topProductLimit: Int! = 10
    @min(value: 1, message: "热销商品数量不能小于1")
    @max(value: 100, message: "热销商品数量不能大于100")
}

enum SalesReportGroupBy {
  DAY
  WEEK
  MONTH
}


input ProductSearchInput {
  page: Int = 0
  size: Int = 20
  search: String
  status: ProductStatus
  keyword: String @size(max: 100, message: "搜索关键词长度不能超过100个字符")
  minSalesVolume: Int @min(value: 0, message: "最小销量不能小于0")
  maxSalesVolume: Int @min(value: 0, message: "最大销量不能小于0")
  sortBy: ProductSortBy! = SALES_VOLUME_DESC
  minPrice: Money
    @positive(message: "最小价格必须为正数")
    @min(value: 1, message: "最小价格不能小于1分")
    @max(value: 9999900, message: "最小价格不能大于99999元")
  maxPrice: Money
    @positive(message: "最大价格必须为正数")
    @min(value: 1, message: "最大价格不能小于1分")
    @max(value: 9999900, message: "最大价格不能大于99999元")
  minStock: Int @min(value: 0, message: "最小库存不能小于0")
  maxStock: Int @min(value: 0, message: "最大库存不能小于0")
}

enum ProductSortBy {
  SALES_VOLUME_DESC
  SALES_VOLUME_ASC
  PRICE_DESC
  PRICE_ASC
  CREATED_AT_DESC
  CREATED_AT_ASC
  SORT_ORDER_ASC
  SORT_ORDER_DESC
  NAME_ASC
  NAME_DESC
}

input BatchStockAdjustmentInput {
  adjustments: [StockAdjustmentInput!]!
    @size(min: 1, max: 100, message: "调整项目数量应在1-100之间")
}

input StockAdjustmentInput {
  productId: PrimaryId! @positive(message: "商品ID必须为正数")
  quantity: Int!
    @min(value: 1, message: "调整数量不能小于1")
    @max(value: 99999, message: "调整数量不能大于99999")
  type: StockAdjustmentType!
  reason: String @size(max: 500, message: "调整原因长度不能超过500个字符")
}

enum StockAdjustmentType {
  INCREASE
  DECREASE
  SET
}

type StockAdjustmentResult {
  productId: PrimaryId!
  success: Boolean!
  message: String!
  previousStock: Int
  newStock: Int
}

type BatchStockAdjustmentResult {
  success: Boolean!
  successCount: Int!
  failureCount: Int!
  results: [StockAdjustmentResult!]!
}

# Delivery Worker Authentication Types
input DeliveryLoginInput {
  code: String!
}

input BindDeliveryPhoneInput {
  openId: String!
  phoneNumber: String!
}

type DeliveryLoginResponse {
  token: String
  refreshToken: String
  needBindPhone: Boolean!
  workerInfo: DeliveryWorkerInfo
  message: String
  openId: String
}

type DeliveryWorkerInfo {
  id: ID!
  name: String!
  phone: String!
  avatarUrl: String
  wechatOpenId: String!
}

# 用户统计
type UserStatistics {
  # 总用户数
  totalUsers: Int!
  # 今日新增用户数
  todayNewUsers: Int!
  # 本月新增用户数
  monthNewUsers: Int!
  # 活跃用户数（30天内有下单）
  activeUsers: Int!
  # 每日新增用户趋势
  dailyNewUsers: [DailyStatistic!]!
  # 登录统计
  loginStatistics: LoginStatistics
}

# 用户登录统计
type LoginStatistics {
  # 今日登录用户数
  todayLogins: Int!
  # 累计登录用户数
  totalLogins: Int!
  # 每日登录趋势
  dailyLogins: [DailyLoginStatistic!]!
}

# 每日登录统计
type DailyLoginStatistic {
  # 日期
  date: String!
  # 登录用户数
  loginCount: Int!
}

# 送水员概览统计
type DeliveryWorkerOverview {
  # 送水员总数
  totalWorkers: Int!
  # 今日在岗送水员数
  todayActiveWorkers: Int!
  # 今日配送中订单数
  deliveringOrders: Int!
  # 今日已完成订单数
  todayCompletedOrders: Int!
}

# 送水员排行
type DeliveryWorkerRankingItem {
  # 送水员ID
  workerId: ID!
  # 送水员姓名
  name: String!
  # 今日完成订单数
  todayCompletedOrders: Int!
  # 好评率
  rating: Float!
  # 累计收入（分）
  totalEarnings: Long!
}

# 每日收款记录状态枚举
enum DailyCollectionStatus {
  DRAFT      # 草稿（配送员刚录入）
  SUBMITTED  # 已提交（待管理员确认）
  CONFIRMED  # 已确认（管理员已确认）
  DISPUTED   # 有争议（金额不匹配）
}

# 每日对账记录状态枚举
enum DailyReconciliationStatus {
  PENDING      # 待对账
  MATCHED      # 匹配（差异在容差范围内）
  DISCREPANCY  # 有差异（超出容差范围）
  REVIEWED     # 已人工复核
}

# 每日收款记录
type DailyCollectionRecord {
  # 记录ID
  id: PrimaryId!
  # 配送员ID
  deliveryWorkerId: PrimaryId!
  # 收款日期
  collectionDate: String!
  # 现金收款金额（分）
  cashAmountCents: Long!
  # 水票数量
  waterTicketCount: Int!
  # 扫码收款金额（分）
  qrCodeAmountCents: Long!
  # 订单数量
  orderCount: Int!
  # 订单金额合计（分）
  orderAmountCents: Long!
  # 差异金额（分）
  differenceAmountCents: Long!
  # 系统计算的现金金额（分）
  calculatedCashAmountCents: Long!
  # 系统计算的扫码金额（分）
  calculatedQrCodeAmountCents: Long!
  # 系统计算的水票数量
  calculatedWaterTicketCount: Int!
  # 系统计算的订单金额（分）
  calculatedOrderAmountCents: Long!
  # 状态
  status: DailyCollectionStatus!
  # 确认时间
  confirmedAt: LocalDateTime
  # 确认人ID
  confirmedBy: PrimaryId
  # 备注
  notes: String
  # 创建时间
  createdAt: LocalDateTime!
  # 更新时间
  updatedAt: LocalDateTime!
}

# 配送员今日收款预计算结果（返回给配送员小程序）
type MyTodayCollectionVO {
  # 今日完成订单数（系统自动计算）
  orderCount: Int!
  # 今日订单金额合计（系统自动计算，单位：分）
  orderAmountCents: Long!
  # 配送员已填写的现金收款金额（分）
  cashAmountCents: Long
  # 配送员已填写的水票数量
  waterTicketCount: Int
  # 配送员已填写的扫码收款金额（分）
  qrCodeAmountCents: Long
  # 差异金额（分）
  differenceAmountCents: Long
  # 系统计算的现金应收金额（分）- 从订单支付统计得出
  calculatedCashAmountCents: Long
  # 系统计算的扫码应收金额（分）- 从订单支付统计得出
  calculatedQrCodeAmountCents: Long
  # 系统计算的水票应收数量 - 从订单支付统计得出
  calculatedWaterTicketCount: Int
  # 系统计算的订单金额合计（分）
  calculatedOrderAmountCents: Long
  # 记录状态
  status: DailyCollectionStatus
}

# 每日对账记录
type DailyReconciliation {
  # 记录ID
  id: PrimaryId!
  # 对账日期
  reconciliationDate: String!
  # 现金总收款（分）
  totalCashAmountCents: Long!
  # 水票总数
  totalWaterTicketCount: Int!
  # 扫码总金额（分）
  totalQrCodeAmountCents: Long!
  # 订单总数
  totalOrderCount: Int!
  # 订单总金额（分）
  totalOrderAmountCents: Long!
  # 收款总金额（分）
  totalCollectionAmountCents: Long!
  # 差异金额（分）
  discrepancyAmountCents: Long!
  # 状态
  status: DailyReconciliationStatus!
  # 报表数据
  reportData: JsonObject
  # 复核时间
  reviewedAt: LocalDateTime
  # 复核人ID
  reviewedBy: PrimaryId
  # 复核备注
  reviewNotes: String
  # 创建时间
  createdAt: LocalDateTime!
  # 更新时间
  updatedAt: LocalDateTime!
}

# 提交每日收款输入
input SubmitDailyCollectionInput {
  # 现金收款金额（分）
  cashAmountCents: Long!
  # 水票数量
  waterTicketCount: Int!
  # 扫码收款金额（分）
  qrCodeAmountCents: Long!
  # 收款日期（可选，默认今天）
  collectionDate: String
  # 差异说明（超出容差时填写）
  notes: String
}

# 确认每日收款输入
input ConfirmDailyCollectionInput {
  # 记录ID
  recordId: PrimaryId!
  # 备注
  notes: String
}

# 复核对账记录输入
input ReviewReconciliationInput {
  # 对账记录ID
  reconciliationId: PrimaryId!
  # 复核备注
  reviewNotes: String!
}
