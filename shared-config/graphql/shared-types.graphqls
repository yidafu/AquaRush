    @min(value: 1, message: "退款金额不能小于1分")
    @max(value: 9999900, message: "退款金额不能大于99999元")
  totalAmount: Money!
    @positive(message: "总金额必须为正数")
    @min(value: 1, message: "总金额不能小于1分")
    @max(value: 9999900, message: "总金额不能大于99999元")
}

input ProcessRefundInput {
