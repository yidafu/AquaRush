  frozenBy: Long
  adminNote: String
}

type DailyPaymentStats {
  date: String!
  totalAmountCents: Long!
  totalTransactions: Long!
  successfulTransactions: Long!
  failedTransactions: Long!
  refundedAmountCents: Long!
  refundCount: Long!
