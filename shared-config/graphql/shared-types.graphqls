  USER_ID_DESC
  PRODUCT_ID_ASC
  PRODUCT_ID_DESC
  PRODUCT_NAME_ASC
  PRODUCT_NAME_DESC
  PRODUCT_PRICE_ASC
  PRODUCT_PRICE_DESC
}

input BatchFavoriteOperationInput {
  userIds: [PrimaryId!]!
    @size(min: 1, max: 1000, message: "用户ID数量应在1-1000之间")
  productIds: [PrimaryId!]!
    @size(min: 1, max: 1000, message: "商品ID数量应在1-1000之间")
  operation: BatchFavoriteOperation!
  reason: String @size(max: 500, message: "操作原因长度不能超过500个字符")
}

enum BatchFavoriteOperation {
  CLEAR_ALL_FAVORITES
  CLEAR_SPECIFIC_PRODUCTS
  EXPORT_FAVORITES
  ANALYZE_FAVORITES
}

input ExportFavoritesInput {
  userId: PrimaryId
  productIds: [PrimaryId!]
  dateFrom: LocalDateTime
  dateTo: LocalDateTime
  format: ExportFormat! = CSV
  includeUserInfo: Boolean! = true
  includeProductInfo: Boolean! = true
}

enum ExportFormat {
  CSV
  EXCEL
  JSON
}

type BatchOperationResult {
  success: Boolean!
  message: String!
  processedCount: Int!
  successCount: Int!
  failureCount: Int!
  errors: [String!]!
  details: Map!
}

type ExportFavoritesResult {
  success: Boolean!
  message: String!
  downloadUrl: String
  fileName: String!
  fileSize: Long!
  recordCount: Int!
  expiresAt: LocalDateTime!
}

input ProductListInput {
  page: Int = 0
  size: Int = 20
  sort: String = "createdAt,desc"
  search: String
  status: ProductStatus
  minPriceCents: Long
    @positive(message: "最小价格必须为正数")
    @min(value: 1, message: "最小价格不能小于1分")
    @max(value: 9999900, message: "最小价格不能大于99999元")
  maxPriceCents: Long
    @positive(message: "最大价格必须为正数")
    @min(value: 1, message: "最大价格不能小于1分")
    @max(value: 9999900, message: "最大价格不能大于99999元")
  minStock: Int @min(value: 0, message: "最小库存不能小于0")
  maxStock: Int @min(value: 0, message: "最大库存不能小于0")
}

input ProductUpdateRequest {
  id: PrimaryId! @positive(message: "商品ID必须为正数")
  name: String
    @size(min: 2, max: 200, message: "商品名称长度应在2-200个字符之间")
  subtitle: String @size(max: 500, message: "商品副标题长度不能超过500个字符")
  priceCents: Long
    @positive(message: "商品价格必须为正数")
    @min(value: 1, message: "商品价格不能小于1分")
    @max(value: 9999900, message: "商品价格不能大于99999元")
  originalPriceCents: Long
    @positive(message: "原价必须为正数")
    @min(value: 1, message: "原价不能小于1分")
    @max(value: 9999900, message: "原价不能大于99999元")
  coverImageUrl: String
    @size(max: 500, message: "封面图片URL长度不能超过500个字符")
  imageGallery: JsonArray
    @size(max: 2000, message: "图片画廊URL长度不能超过2000个字符")
  specification: String
    @size(min: 1, max: 100, message: "商品规格长度应在1-100个字符之间")
  waterSource: String @size(max: 200, message: "水源地长度不能超过200个字符")

  mineralContent: String
    @size(max: 200, message: "矿物质含量长度不能超过200个字符")
  stock: Int
    @min(value: 0, message: "库存数量不能小于0")
    @max(value: 99999, message: "库存数量不能大于99999")
  salesVolume: Int @min(value: 0, message: "销量不能小于0")
  status: ProductStatus
  sortOrder: Int
    @min(value: 0, message: "排序权重不能小于0")
    @max(value: 9999, message: "排序权重不能大于9999")
  tags: JsonArray
  detailContent: String
    @size(max: 5000, message: "详情内容长度不能超过5000个字符")
  certificateImages: JsonArray
}

