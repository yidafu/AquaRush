# Payment Refund Types
type RefundRequest {
  # 退款请求ID
  id: String!
  # 原交易ID
  originalTransactionId: String!
  # 订单ID
  orderId: PrimaryId!
  # 用户ID
  userId: PrimaryId!
  # 退款金额（分）
  amountCents: Long!
  # 退款原因
  reason: String!
  # 退款状态
  status: RefundStatus!
  # 申请时间
  requestedAt: LocalDateTime!
  # 处理时间
  processedAt: LocalDateTime
  # 处理人ID
  processedBy: Long
  # 管理员备注
  adminNote: String
}

enum RefundStatus {
  PENDING
  APPROVED
  REJECTED
  COMPLETED
  FAILED
}

# 退款类型(R-PAY-02/G06:退款账本区分口径,营收统计仅计入 ORDER_REFUND)
enum RefundType {
  ORDER_REFUND # 订单退款(含商品+配送费)
  DEPOSIT_REFUND # 水桶费退还(含历史桶押金退还,不计入退款/净营收统计)
}

# Payment Transaction Types
type PaymentTransaction {
  # 交易ID
  id: String!
  # 订单ID
  orderId: PrimaryId!
  # 用户ID
  userId: PrimaryId!
  # 交易金额（分）
  amountCents: Long!
  # 交易状态
  status: PaymentStatus!
  # 支付方式
  paymentMethod: PaymentMethod!
  # 交易流水号
  transactionId: String
  # 外部交易号
  externalTransactionId: String
  # 支付网关
  gateway: String!
  # 创建时间
  createdAt: LocalDateTime!
  # 更新时间
  updatedAt: LocalDateTime!
  # 完成时间
  completedAt: LocalDateTime
  # 失败原因
  failureReason: String
  # 附加数据
  metadata: Map
  # 管理员备注
  adminNote: String
}

input ExportTransactionsInput {
  dateFrom: LocalDateTime
  dateTo: LocalDateTime
  status: PaymentStatus
  paymentMethod: PaymentMethod
  userId: PrimaryId @positive(message: "用户ID必须为正数")
  minAmountCents: Long
    @positive(message: "最小金额必须为正数")
    @min(value: 1, message: "最小金额不能小于1分")
    @max(value: 9999900, message: "最小金额不能大于99999元")
  maxAmountCents: Long
    @positive(message: "最大金额必须为正数")
    @min(value: 1, message: "最大金额不能小于1分")
    @max(value: 9999900, message: "最大金额不能大于99999元")
  format: String! = "CSV"  # CSV, EXCEL, PDF
    @size(min: 1, max: 10, message: "导出格式长度应在1-10个字符之间")
  includeMetadata: Boolean! = false
}

# Payment Statistics Types
type PaymentStatistics {
  totalAmountCents: Long!
  totalTransactions: Long!
