# Shared GraphQL Types between User Service and Delivery/Admin Service
# These types are needed by both services and should be identical

# Scalar types
scalar Long
scalar BigDecimal
scalar Float
scalar LocalDateTime
scalar Map
scalar JsonObject
scalar JsonArray
scalar PrimaryId

# Validation Directives
directive @notBlank(
  message: String
) on ARGUMENT_DEFINITION | INPUT_FIELD_DEFINITION
directive @size(
  min: Int
  max: Int
  message: String
) on ARGUMENT_DEFINITION | INPUT_FIELD_DEFINITION
directive @email(
  message: String
) on ARGUMENT_DEFINITION | INPUT_FIELD_DEFINITION
directive @pattern(
  regexp: String!
  message: String
) on ARGUMENT_DEFINITION | INPUT_FIELD_DEFINITION
directive @positive(
  message: String
) on ARGUMENT_DEFINITION | INPUT_FIELD_DEFINITION
directive @future(
  message: String
) on ARGUMENT_DEFINITION | INPUT_FIELD_DEFINITION
directive @past(message: String) on ARGUMENT_DEFINITION | INPUT_FIELD_DEFINITION
directive @min(
  value: Float!
  message: String
) on ARGUMENT_DEFINITION | INPUT_FIELD_DEFINITION
directive @max(
  value: Float!
  message: String
) on ARGUMENT_DEFINITION | INPUT_FIELD_DEFINITION

# Enum types - Common across all services
enum OrderStatus {
  PENDING_PAYMENT
  PENDING_DISPATCH
  PENDING_DELIVERY
  DELIVERING
  COMPLETED
  CANCELLED
  REFUNDED
}

# 配送照片核验状态(G23/F-ORD-021:后台「通过/驳回」核验流)
enum DeliveryPhotoReviewStatus {
  PENDING # 待核验(已上传照片,未审核)
  APPROVED # 已通过
  REJECTED # 已驳回
}

# 配送照片核验动作(G23:后台核验操作)
enum DeliveryPhotoReviewAction {
  APPROVE # 通过
  REJECT # 驳回
}

enum ProductStatus {
  ONLINE
  OFFLINE
  OUT_OF_STOCK
}

enum UserRole {
  USER
  ADMIN
  WORKER
  NONE
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  DELETED
  ONLINE
}

enum DeliveryWorkerStatus {
  ONLINE
  OFFLINE
}

enum AdminRole {
  SUPER_ADMIN
  ADMIN
  DELIVERY_WORKER
}

# 后台账号状态(F-USR-020/021):停用账号不可登录/不可派单接单
enum AdminAccountStatus {
  ACTIVE
  DISABLED
}

enum PaymentStatus {
  SUCCESS
  FAILED
  PROCESSING
  REFUNDED
}

enum PaymentMethod {
  WECHAT_PAY
  ALIPAY
  CASH_ON_DELIVERY
}

# 收款方式枚举 - 用于记录配送员完成配送时的收款方式
enum PaymentType {
  WATER_TICKET # 水票
  CASH # 现金
  QR_CODE # 扫码
}

# 配送时段枚举(AC-ORD-001-05 配送时间随单落库;与用户端 DeliveryTimeSelector 一一对应)
enum DeliveryTimeSlot {
  IMMEDIATE # 立即配送(30分钟内)
  MORNING # 上午配送(9:00-12:00)
  AFTERNOON # 下午配送(14:00-18:00)
  EVENING # 晚上配送(18:00-21:00)
}

# 订单操作类型枚举
enum OrderOperationType {
  ORDER_CREATED          # 订单创建
  ORDER_PAID             # 支付成功
  ORDER_CANCELLED        # 订单取消
  DELIVERY_ASSIGNED      # 配送员分配
  DELIVERY_STARTED       # 开始配送
  DELIVERY_COMPLETED     # 配送完成
  ORDER_COMPLETED        # 订单完成
  REFUND_INITIATED       # 退款发起
  REFUND_COMPLETED       # 退款完成
  PAYMENT_TIMEOUT        # 支付超时
}

# 操作人类型枚举
enum OperatorType {
  USER              # 普通用户
  ADMIN             # 管理员
  DELIVERY_WORKER   # 配送员
  SYSTEM            # 系统自动
}

# 订单操作记录类型
type OrderOperation {
  id: PrimaryId!
  orderId: PrimaryId!
  operationType: OrderOperationType!
  operatorId: PrimaryId
  operatorType: OperatorType
  description: String
  extraData: JsonObject
  createdAt: LocalDateTime!
}

# Core Domain Types
type User {
  # 用户唯一标识ID
  id: PrimaryId!
  # 微信OpenID
  wechatOpenId: String!
  # 用户昵称
  nickname: String
  # 用户手机号
  phone: String
  # 用户头像URL
  avatarUrl: String
  # 创建时间
  createdAt: LocalDateTime!
  # 更新时间
  updatedAt: LocalDateTime!
}

type Product {
  # 商品唯一标识ID
  id: PrimaryId!
  # 商品名称
  name: String!
  # 商品副标题
  subtitle: String
  # 商品价格（分）
  priceCents: Long!
  # 商品原价（分）
  originalPriceCents: Long
  # 商品封面图片URL
  coverImageUrl: String!
  # 商品图片画廊
  imageGallery: JsonArray
  # 商品规格（如18.9L桶装水）
  specification: String!
  # 水源地
  waterSource: String
  # 矿物质含量
  mineralContent: String
  # 库存数量
  stock: Int!
  # 销量
  salesVolume: Int!
  # 商品状态
  status: ProductStatus!
  # 排序权重
  sortOrder: Int!
  # 商品标签
  tags: JsonArray
  # 商品详情内容
  detailContent: String
  # 证书图片列表
  certificateImages: JsonArray
  # 创建时间
  createdAt: LocalDateTime!
  # 更新时间
  updatedAt: LocalDateTime!
}

type Address {
  # 地址唯一标识ID
  id: PrimaryId!
  # 用户ID
  userId: PrimaryId!
  # 收货人姓名
  receiverName: String!
  # 收货人手机号
  phone: String!
  # 省份
  province: String!
  # 省份代码
  provinceCode: String
  # 城市
  city: String!
  # 城市代码
  cityCode: String
  # 区县
  district: String!
  # 区县代码
  districtCode: String
  # 详细地址
  detailAddress: String!
  # 楼层(空=无楼层信息/平房,配送费楼层判定用 —— R-MON-02)
  floor: Int
  # 经度
  longitude: Float
  # 纬度
  latitude: Float
  # 是否为默认地址
  isDefault: Boolean!
  # 创建时间
  createdAt: LocalDateTime!
  # 更新时间
  updatedAt: LocalDateTime!
}

type DeliveryAddress {
  # 配送地址唯一标识ID
  id: PrimaryId!
  # 用户ID
  userId: PrimaryId!
  # 收货人姓名
  receiverName: String!
  # 收货人手机号
  receiverPhone: String!
  # 省份
  province: String!
  # 城市
  city: String!
  # 区县
  district: String!
  # 详细地址
  detailAddress: String!
  # 经度
  longitude: Float
  # 纬度
  latitude: Float
  # 创建时间
  createdAt: LocalDateTime!
  # 更新时间
  updatedAt: LocalDateTime!
}

type Order {
  # 订单唯一标识ID
  id: PrimaryId!
  # 订单编号
  orderNo: String!
  # 下单用户
  user: User
  # 配送地址
  address: Address
  # 订单商品明细(F-ORD-004 多商品下单,权威数据源 order_items 表)
  items: [OrderItemVO!]!
  # 订单金额（分）
  amountCents: Long!
  # 配送费(分,下单时按配送费规则快照,规则变更不影响已生成订单 —— R-MON-02)
  deliveryFeeCents: Long!
  # 应付合计(分)= amountCents + deliveryFeeCents(纯展示口径)
  payAmountCents: Long!
  # 订单状态
  status: OrderStatus!
  # 支付方式
  paymentMethod: String
  # 支付交易流水号
  paymentTransactionId: String
  # 支付时间
  paymentTime: LocalDateTime
  # 配送员信息
  deliveryWorker: DeliveryWorker
  # 配送照片列表
  deliveryPhotos: [String!]
  # 配送照片核验状态(PENDING/APPROVED/REJECTED;null=未核验 —— G23/F-ORD-021)
  deliveryPhotoReviewStatus: DeliveryPhotoReviewStatus
  # 配送照片核验时间
  deliveryPhotoReviewedAt: LocalDateTime
  # 配送照片核验人ID
  deliveryPhotoReviewedBy: PrimaryId
  # 配送照片核验备注
  deliveryPhotoReviewRemark: String
  # 水桶费快照(分,历史字段——2026-08 水桶费改造后新订单恒为 0,仅旧订单有值,见 14-misc.md §G06)
  depositCents: Long!
  # 是否自收（水钱已收/水票已扣）
  isSelfCollect: Boolean!
  # 收款方式
  paymentType: PaymentType
  # 开始配送时间
  deliveryStartedAt: LocalDateTime
  # 配送确认时间
  deliveryConfirmedAt: LocalDateTime
  # 订单完成时间
  completedAt: LocalDateTime
  # 订单备注
  remark: String
  # 配送时段(下单时快照,AC-ORD-001-05;null=未指定,默认立即配送)
  deliveryTimeSlot: DeliveryTimeSlot
  # 创建时间
  createdAt: LocalDateTime!
  # 更新时间
  updatedAt: LocalDateTime!
  # 满减/折扣优惠快照(分,叠加① —— R-MKT-07)
  promotionDiscountCents: Long
  # 满减/折扣活动名快照(费用明细「满减(活动名)」展示 —— R-MKT-04)
  promotionActivityName: String
  # 首单立减优惠(分,叠加①与满减互斥取最大 —— R-MKT-10)
  firstOrderDiscountCents: Long
  # 首单立减活动名快照(费用明细「首单立减(活动名)」展示 —— R-MKT-10)
  firstOrderActivityName: String
  # 优惠券优惠快照(分,叠加③ —— R-MKT-07,一单一券)
  couponDiscountCents: Long
  # 优惠券名快照(费用明细「优惠券(券名)」展示 —— R-MKT-03)
  couponName: String
  # 水票核销张数快照(一票抵一桶,费用明细「水票抵扣(N桶)」展示 —— R-MKT-08)
  ticketRedeemCount: Int
  # 水票抵扣金额快照(分,被核销桶按单价 0 计入应付的差额 —— R-MKT-08)
  ticketDiscountCents: Long
  # 买赠/满赠赠品行(附加 0 价行,随单配送 —— R-MKT-09)
  giftItems: [GiftItemVO!]
}

# 订单商品明细项(F-ORD-004 多商品下单:成交单价/小计随单快照,商品信息取快照)
type OrderItemVO {
  productId: PrimaryId!
  # 商品信息(下单时快照:名称/规格/封面/目录价)
  product: Product!
  # 购买数量
  quantity: Int!
  # 成交单价(分,下单时营销引擎解析结果 —— R-MKT-02)
  unitPriceCents: Long!
  # 商品小计(分)= 成交单价 × 数量
  totalPriceCents: Long!
}

# 赠品行(R-MKT-09:赠品为附加 0 价行,单价 ¥0.00 由前端呈现,不传价)
type GiftItemVO {
  productId: PrimaryId!
  productName: String!
  quantity: Int!
}

type DeliveryWorker {
  # 配送员唯一标识ID(送水员档案并入 admins 单表后=账号 id)
  id: PrimaryId!
  # 用户ID
  userId: PrimaryId!
  # 微信OpenID
  wechatOpenId: String!
  # 配送员姓名
  name: String!
  # 配送员手机号
  phone: String!
  # 角色(账号行投影:DELIVERY_WORKER/ADMIN)
  role: String!
  # 配送员头像URL
  avatarUrl: String
  # 在线状态
  onlineStatus: DeliveryWorkerStatus!
  # 账号状态(停用后不可登录/不可派单接单;F-USR-021)
  accountStatus: AdminAccountStatus!
  # 坐标位置（经纬度格式）
  coordinates: String
  # 当前位置描述
  currentLocation: String
  # 评分
  rating: BigDecimal
  # 总订单数
  totalOrders: Int!
  # 已完成订单数
  completedOrders: Int!
  # 平均评分
  averageRating: BigDecimal
  # 收入（分）
  earningCents: Long
  # 是否可接单
  isAvailable: Boolean!
  # 当前任务数（待配送订单数）
  currentTaskCount: Int!
  # 创建时间
  createdAt: LocalDateTime!
  # 更新时间
  updatedAt: LocalDateTime!
}

# 配送轨迹点(PRD 05-address-delivery.md §F-ADR-012,R-ADR-03)
# 送水工在订单「配送中」期间按设定频率(默认 5s)上报的实时位置点;
# 轨迹涉及用户收货地址隐私,仅管理员可查(R-AUTH-02)。
type DeliveryTrajectory {
  id: PrimaryId!
  # 送水工账号 id(admins 单表,迁移 v1.2.1)
  deliveryWorkerId: PrimaryId!
  # 关联订单
  orderId: PrimaryId!
  # 经度
  longitude: Float!
  # 纬度
  latitude: Float!
  # 定位精度(米)
  accuracy: Float
  # 上报时间(客户端定位产生时间)
  reportedAt: LocalDateTime!
  # 服务端落库时间
  createdAt: LocalDateTime!
}

# 当日统计数据 - 用于配送员小程序
type TodayStatistics {
  # 今日总订单数
  totalOrders: Int!
  # 今日已完成订单数
  completedOrders: Int!
  # 今日待配送订单数
  unfinishedOrders: Int!
  # 今日收入（分）
  earningCents: Long!
}

# 每日统计数据
type DailyStat {
  # 日期（MM/dd格式）
  date: String!
  # 订单数
  orderCount: Int!
  # 营收金额（分）
  earningCents: Long!
}

# 一周统计数据
type WeekStatistics {
  # 每日统计数据列表
  dailyStats: [DailyStat!]!
  # 总订单数
  totalOrders: Int!
  # 总营收金额（分）
  totalEarningCents: Long!
}

type DeliveryArea {
  # 配送区域ID
  id: PrimaryId!
  # 配送区域名称
  name: String!
  # 省份
  province: String!
  # 城市
  city: String!
  # 区县
  district: String!
  # 是否启用
  enabled: Boolean!
}

type Region {
  # 区域ID
  id: PrimaryId!
  # 区域名称
  name: String!
  # 区域代码
  code: String!
  # 父级区域代码
  parentCode: String
  # 区域级别（1-省/2-市/3-区）
  level: Int!
  # 创建时间
  createdAt: LocalDateTime!
  # 更新时间
  updatedAt: LocalDateTime!
}

# Authentication Types
type AuthPayload {
  # 访问令牌
  accessToken: String!
  # 刷新令牌
  refreshToken: String!
  # 用户信息
  user: User!
}

type UserInfo {
  # 用户ID
  id: PrimaryId!
  # 微信OpenID
  wechatOpenId: String!
  # 用户昵称
  nickname: String
  # 用户手机号
  phone: String
  # 用户头像URL
  avatarUrl: String
  # 创建时间
  createdAt: LocalDateTime!
  # 更新时间
  updatedAt: LocalDateTime!
}

type Admin {
  # 管理员ID
  id: PrimaryId!
  # 用户名
  username: String!
  # 真实姓名
  realName: String
  # 手机号
  phone: String
  # 角色
  role: String!
  # 账号状态(停用后不可登录;F-USR-020)
  accountStatus: AdminAccountStatus!
  # 最后登录时间
  lastLoginAt: LocalDateTime
  # 头像URL(送水员档案并入账号行,纯管理账号留空)
  avatarUrl: String
  # 在线状态
  onlineStatus: DeliveryWorkerStatus!
  # 坐标位置(经纬度格式)
  coordinates: String
  # 当前位置描述
  currentLocation: String
  # 评分
  rating: BigDecimal
  # 总订单数
  totalOrders: Int!
  # 已完成订单数
  completedOrders: Int!
  # 平均评分
  averageRating: BigDecimal
  # 收入(分)
  earningCents: Long
  # 是否可接单
  isAvailable: Boolean!
  # 创建时间
  createdAt: LocalDateTime!
  # 更新时间
  updatedAt: LocalDateTime!
}

type WeChatLoginResponse {
  # 访问令牌
  accessToken: String!
  # 刷新令牌
  refreshToken: String!
  # 过期时间（秒）
  expiresIn: Int!
  # 用户信息
  userInfo: UserInfo!
}

type WeChatTokenResponse {
  # 访问令牌
  accessToken: String!
  # 刷新令牌
  refreshToken: String!
  # 过期时间（秒）
  expiresIn: Int!
}

type PaymentData {
  # 支付二维码URL
  codeUrl: String!
  # 商户订单号
  outTradeNo: String!
  # 微信应用ID
  appId: String!
  # 时间戳
  timeStamp: String!
  # 随机字符串
  nonceStr: String!
  # 订单详情扩展字符串
  packageValue: String!
  # 签名方式
  signType: String!
  # 签名
  paySign: String!
}

# Statistics Types
type OrderStatistics {
  # 订单总数
  totalOrders: Int!
  # 已完成订单数（口径 = 状态为「已完成」的订单数，G38）
  completedOrders: Int!
  # 总收入（口径 = 已完成订单金额合计，仅 COMPLETED 状态）
  totalRevenueCents: Long!
  # 平均订单金额（客单价 = 已完成营收 / 已完成订单数）
  averageOrderValueCents: Long!
  # 已退款金额（口径 = payment_refunds status=COMPLETED，按退款成功时间归属窗口，F-STA-002）
  refundAmountCents: Long!
  # 净营收（= 已完成营收 − 已退款金额；跨窗口退款时可为负，F-STA-002）
  netRevenueCents: Long!
  # 日期范围
  dateRange: DateRange!
  # 订单状态分布（G37，7 态聚合所选范围订单数，合计 = totalOrders）
  statusDistribution: [OrderStatusStatistic!]!
  # 客单价分布（G37，按金额区间聚合订单数，合计 = totalOrders）
  orderValueDistribution: [OrderValueBucketStatistic!]!
  # 高峰时段分析（G37，按订单创建小时 0-23 聚合，合计 = totalOrders）
  peakHourDistribution: [PeakHourStatistic!]!
}

# 订单状态分布项（G37）
type OrderStatusStatistic {
  # 订单状态
  status: OrderStatus!
  # 该状态订单数
  count: Int!
}

# 客单价分布区间（G37，金额单位分；fromCents 含下限、toCents 不含上限，null = 开区间）
type OrderValueBucketStatistic {
  # 区间下限（分，含）
  fromCents: Long
  # 区间上限（分，不含）
  toCents: Long
  # 区间标签（如「0-20元」）
  label: String!
  # 该区间订单数
  count: Int!
}

# 高峰时段分析项（G37，0-23 时）
type PeakHourStatistic {
  # 小时（0-23）
  hour: Int!
  # 该小时订单数
  count: Int!
}

type DateRange {
  # 开始日期
  startDate: LocalDateTime!
  # 结束日期
  endDate: LocalDateTime!
}

type DailyStatistic {
  # 日期
  date: String!
  # 订单数量
  orderCount: Int!
  orderProductCount: Int!
  # 收入（单位：分）
  revenueCents: Long!
  # 该日已退款金额（单位：分，退款记录 status=COMPLETED 按退款成功时间归属，F-STA-002）
  refundCents: Long!
}

type WeeklyStatistic {
  # 周数
  weekNumber: Int!
  # 年份
  year: Int!
  # 开始日期
  startDate: String!
  # 结束日期
  endDate: String!
  # 订单数量
  orderCount: Int!
  orderProductCount: Int!
  # 收入（单位：分）
  revenueCents: Long!
  # 该周已退款金额（单位：分，F-STA-002）
  refundCents: Long!
}

type MonthlyStatistic {
  # 月份
  month: Int!
  # 年份
  year: Int!
  # 月份名称
  monthName: String!
  # 订单数量
  orderCount: Int!
  orderProductCount: Int!
  # 收入（单位：分）
  revenueCents: Long!
  # 该月已退款金额（单位：分，F-STA-002）
  refundCents: Long!
}

# Common Input Types
input DateRangeInput {
  startDate: LocalDateTime!
  endDate: LocalDateTime!
}

input RefreshTokenInput {
  refreshToken: String!
    @notBlank(message: "刷新令牌不能为空")
    @size(min: 10, max: 1000, message: "刷新令牌长度应在10-1000个字符之间")
}

input UpdateProfileInput {
  nickname: String @size(min: 2, max: 50, message: "昵称长度应在2-50个字符之间")
  phone: String
    @pattern(regexp: "^1[3-9]\\\\d{9}$", message: "手机号格式不正确")
  avatar: String @size(max: 500, message: "头像URL长度不能超过500个字符")
}

input UpdateAddressInput {
  receiverName: String
    @notBlank(message: "收货人姓名不能为空")
    @size(min: 2, max: 20, message: "收货人姓名长度应在2-20个字符之间")
  phone: String
    @notBlank(message: "收货人手机号不能为空")
    @pattern(regexp: "^1[3-9]\\\\d{9}$", message: "手机号格式不正确")
  province: String @notBlank(message: "省份不能为空")
  provinceCode: String
    @size(min: 1, max: 20, message: "省份代码长度应在1-20个字符之间")
  city: String @notBlank(message: "城市不能为空")
  cityCode: String
    @size(min: 1, max: 20, message: "城市代码长度应在1-20个字符之间")
  district: String @notBlank(message: "区县不能为空")
  districtCode: String
    @size(min: 1, max: 20, message: "区县代码长度应在1-20个字符之间")
  detailAddress: String
    @notBlank(message: "详细地址不能为空")
    @size(min: 5, max: 200, message: "详细地址长度应在5-200个字符之间")
  floor: Int @min(value: 1, message: "楼层必须大于0")
  longitude: Float
    @min(value: -180, message: "经度不能小于-180")
    @max(value: 180, message: "经度不能大于180")
  latitude: Float
    @min(value: -90, message: "纬度不能小于-90")
    @max(value: 90, message: "纬度不能大于90")
  isDefault: Boolean
}

# 送水端订单页地址信息修改(F-ORD-024):配送员/管理员在配送任务中修正收货人信息、
# 定位(WGS-84 经纬度)与楼层等;仅传入字段生效(不传=保持不变),空值字段不覆盖。
input UpdateOrderAddressInput {
  receiverName: String
    @notBlank(message: "收货人姓名不能为空")
    @size(min: 2, max: 20, message: "收货人姓名长度应在2-20个字符之间")
  phone: String
    @notBlank(message: "收货人手机号不能为空")
    @pattern(regexp: "^1[3-9]\\\\d{9}$", message: "手机号格式不正确")
  detailAddress: String
    @notBlank(message: "详细地址不能为空")
    @size(min: 5, max: 200, message: "详细地址长度应在5-200个字符之间")
  floor: Int @min(value: 1, message: "楼层必须大于0")
  longitude: Float
    @min(value: -180, message: "经度不能小于-180")
    @max(value: 180, message: "经度不能大于180")
  latitude: Float
    @min(value: -90, message: "纬度不能小于-90")
    @max(value: 90, message: "纬度不能大于90")
}

input AddressInput {
  receiverName: String!
    @notBlank(message: "收货人姓名不能为空")
    @size(min: 2, max: 20, message: "收货人姓名长度应在2-20个字符之间")
  phone: String!
    @notBlank(message: "收货人手机号不能为空")
    @pattern(regexp: "^1[3-9]\\\\d{9}$", message: "手机号格式不正确")
  province: String! @notBlank(message: "省份不能为空")
  provinceCode: String!
    @size(min: 1, max: 20, message: "省份代码长度应在1-20个字符之间")
  city: String! @notBlank(message: "城市不能为空")
  cityCode: String!
    @size(min: 1, max: 20, message: "城市代码长度应在1-20个字符之间")
  district: String! @notBlank(message: "区县不能为空")
  districtCode: String!
    @size(min: 1, max: 20, message: "区县代码长度应在1-20个字符之间")
  detailAddress: String!
    @notBlank(message: "详细地址不能为空")
    @size(min: 5, max: 200, message: "详细地址长度应在5-200个字符之间")
  floor: Int @min(value: 1, message: "楼层必须大于0")
  longitude: Float
    @min(value: -180, message: "经度不能小于-180")
    @max(value: 180, message: "经度不能大于180")
  latitude: Float
    @min(value: -90, message: "纬度不能小于-90")
    @max(value: 90, message: "纬度不能大于90")
  isDefault: Boolean! = false
}

input OrderItemInput {
  productId: PrimaryId! @positive(message: "商品ID必须为正数")
  quantity: Int!
    @min(value: 1, message: "购买数量不能少于1")
    @max(value: 999, message: "购买数量不能超过999")
}

input CreateOrderInput {
  # 商品明细列表(F-ORD-004 多商品下单;单商品=单元素;同一商品不可重复)
  items: [OrderItemInput!]!
  addressId: PrimaryId! @positive(message: "地址ID必须为正数")
  remark: String @size(max: 500, message: "备注长度不能超过500个字符")
  # 服务端下单幂等键(R-ORD-06):同一用户同一 clientRequestId 重复提交不产生重复订单;
  # 缺省时维持旧行为(仅前端 loading 防重)
  clientRequestId: String @size(max: 64, message: "clientRequestId长度不能超过64个字符")
  # 配送时段(AC-ORD-001-05,缺省=立即配送 IMMEDIATE)
  deliveryTime: DeliveryTimeSlot
  # 优惠券选择(促销引擎 R-MKT-07 叠加③):省略=引擎自动选最优,0=不用券;一单一券
  # 类型用 Long 而非 PrimaryId:0 是合法的「不用券」哨兵值,PrimaryId 标量会拒绝 0
  preferredCouponId: Long @min(value: 0, message: "优惠券ID无效")
  # 水票核销张数(一票抵一桶 R-MKT-08,≤下单桶数 ∩ 可用张数)
  ticketRedeemCount: Int
    @min(value: 0, message: "水票核销张数无效")
    @max(value: 999, message: "水票核销张数不能超过999")
}

# 配送员创建订单输入类型(F-ORD-012 代客下单,多商品 items 口径 —— F-ORD-004)
input CreateDeliveryOrderInput {
  # 商品明细列表(多商品;单商品=单元素;同一商品不可重复)
  items: [OrderItemInput!]!
  addressId: PrimaryId! @positive(message: "地址ID必须为正数")
  # 是否自收（水钱已收/水票已扣），默认 false
  isSelfCollect: Boolean = false
  remark: String @size(max: 500, message: "备注长度不能超过500个字符")
}

input WechatLoginInput {
  code: String!
    @notBlank(message: "微信授权码不能为空")
    @size(min: 10, max: 100, message: "授权码长度应在10-100个字符之间")
}

input CreateProductInput {
  name: String!
    @notBlank(message: "商品名称不能为空")
    @size(min: 2, max: 200, message: "商品名称长度应在2-200个字符之间")
  subtitle: String @size(max: 500, message: "商品副标题长度不能超过500个字符")
  priceCents: Long!
    @positive(message: "商品价格必须为正数")
    @min(value: 1, message: "商品价格不能小于1分")
    @max(value: 9999900, message: "商品价格不能大于99999元")
  originalPriceCents: Long
    @positive(message: "原价必须为正数")
    @min(value: 1, message: "原价不能小于1分")
    @max(value: 9999900, message: "原价不能大于99999元")
  coverImageUrl: String!
    @notBlank(message: "商品封面图片不能为空")
    @size(max: 500, message: "封面图片URL长度不能超过500个字符")
  imageGallery: JsonArray
  specification: String!
    @notBlank(message: "商品规格不能为空")
    @size(min: 1, max: 100, message: "商品规格长度应在1-100个字符之间")
  waterSource: String @size(max: 200, message: "水源地长度不能超过200个字符")

  mineralContent: String
    @size(max: 200, message: "矿物质含量长度不能超过200个字符")
  stock: Int!
    @min(value: 0, message: "库存数量不能小于0")
    @max(value: 99999, message: "库存数量不能大于99999")
  salesVolume: Int! @min(value: 0, message: "销量不能小于0")
  status: ProductStatus!
  sortOrder: Int!
    @min(value: 0, message: "排序权重不能小于0")
    @max(value: 9999, message: "排序权重不能大于9999")
  tags: JsonArray
  detailContent: String
    @size(max: 5000, message: "详情内容长度不能超过5000个字符")
  certificateImages: JsonArray
}

