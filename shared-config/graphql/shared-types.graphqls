# Shared GraphQL Types between User Service and Delivery/Admin Service
# These types are needed by both services and should be identical

# Scalar types
scalar Long
scalar BigDecimal
scalar Money
scalar Float
scalar LocalDateTime
scalar Map
scalar JsonObject
scalar JsonArray
scalar PrimaryId

# Validation Directives
directive @notBlank(
  message: String
) on ARGUMENT_DEFINITION | INPUT_FIELD_DEFINITION
directive @size(
  min: Int
  max: Int
  message: String
) on ARGUMENT_DEFINITION | INPUT_FIELD_DEFINITION
directive @email(
  message: String
) on ARGUMENT_DEFINITION | INPUT_FIELD_DEFINITION
directive @pattern(
  regexp: String!
  message: String
) on ARGUMENT_DEFINITION | INPUT_FIELD_DEFINITION
directive @positive(
  message: String
) on ARGUMENT_DEFINITION | INPUT_FIELD_DEFINITION
directive @future(
  message: String
) on ARGUMENT_DEFINITION | INPUT_FIELD_DEFINITION
directive @past(message: String) on ARGUMENT_DEFINITION | INPUT_FIELD_DEFINITION
directive @min(
  value: Float!
  message: String
) on ARGUMENT_DEFINITION | INPUT_FIELD_DEFINITION
directive @max(
  value: Float!
  message: String
) on ARGUMENT_DEFINITION | INPUT_FIELD_DEFINITION

# Enum types - Common across all services
enum OrderStatus {
  PENDING_PAYMENT
  PENDING_DISPATCH
  PENDING_DELIVERY
  DELIVERING
  COMPLETED
  CANCELLED
  REFUNDED
}

enum ProductStatus {
  ONLINE
  OFFLINE
  OUT_OF_STOCK
}

enum UserRole {
  USER
  ADMIN
  WORKER
  NONE
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  DELETED
  ONLINE
}

enum DeliveryWorkerStatus {
  ONLINE
  OFFLINE
}

enum AdminRole {
  SUPER_ADMIN
  ADMIN
  DELIVERY_WORKER
}

enum PaymentStatus {
  SUCCESS
  FAILED
  PROCESSING
  REFUNDED
}

enum PaymentMethod {
  WECHAT_PAY
  ALIPAY
  CASH_ON_DELIVERY
}

# 收款方式枚举 - 用于记录配送员完成配送时的收款方式
enum PaymentType {
  WATER_TICKET # 水票
  CASH # 现金
  QR_CODE # 扫码
}

# 押桶状态枚举
enum BucketDepositStatus {
  DEPOSITED # 已押桶（待退还）
  REFUNDED # 已退还
}

# 订单操作类型枚举
enum OrderOperationType {
  ORDER_CREATED          # 订单创建
  ORDER_PAID             # 支付成功
  ORDER_CANCELLED        # 订单取消
  DELIVERY_ASSIGNED      # 配送员分配
  DELIVERY_STARTED       # 开始配送
  DELIVERY_COMPLETED     # 配送完成
  ORDER_COMPLETED        # 订单完成
  REFUND_INITIATED       # 退款发起
  REFUND_COMPLETED       # 退款完成
  PAYMENT_TIMEOUT        # 支付超时
}

# 操作人类型枚举
enum OperatorType {
  USER              # 普通用户
  ADMIN             # 管理员
  DELIVERY_WORKER   # 配送员
  SYSTEM            # 系统自动
}

# 订单操作记录类型
type OrderOperation {
  id: PrimaryId!
  orderId: PrimaryId!
  operationType: OrderOperationType!
  operatorId: PrimaryId
  operatorType: OperatorType
  description: String
  extraData: JsonObject
  createdAt: LocalDateTime!
}

# 押桶记录类型
type BucketDeposit {
  id: PrimaryId!
  userId: PrimaryId!
  quantity: Int!
  amountCents: Long!
  status: BucketDepositStatus!
  paymentTransactionId: String
  paymentTime: LocalDateTime
  refundedAt: LocalDateTime
  refundedBy: PrimaryId
  remark: String
  createdAt: LocalDateTime!
  updatedAt: LocalDateTime!
}

# 押桶记录分页类型
type BucketDepositVOPage {
  list: [BucketDeposit!]!
  pageInfo: PageInfo!
}

# Product pagination type used by client queries
type ProductVoPage {
  list: [Product!]!
  pageInfo: PageInfo!
}

# FavoriteProduct pagination type used by client queries
type FavoriteProductVoPage {
  list: [FavoriteProduct!]!
  pageInfo: PageInfo!
}

# 押桶输入类型
input CreateBucketDepositInput {
  quantity: Int!
    @min(value: 1, message: "押桶数量不能少于1")
    @max(value: 99, message: "押桶数量不能超过99")
}

# 押桶退还输入类型
input RefundBucketDepositInput {
  depositId: PrimaryId! @positive(message: "押桶记录ID必须为正数")
  remark: String @size(max: 500, message: "备注长度不能超过500个字符")
}

# Core Domain Types
type User {
  # 用户唯一标识ID
  id: PrimaryId!
  # 微信OpenID
  wechatOpenId: String!
  # 用户昵称
  nickname: String
  # 用户手机号
  phone: String
  # 用户头像URL
  avatarUrl: String
  # 创建时间
  createdAt: LocalDateTime!
  # 更新时间
  updatedAt: LocalDateTime!
}

type Product {
  # 商品唯一标识ID
  id: PrimaryId!
  # 商品名称
  name: String!
  # 商品副标题
  subtitle: String
  # 商品价格（分）
  price: Money!
  # 商品原价（分）
  originalPrice: Money
  # 押金价格（分）
  depositPrice: Money
  # 商品封面图片URL
  coverImageUrl: String!
  # 商品图片画廊
  imageGallery: JsonArray
  # 商品规格（如18.9L桶装水）
  specification: String!
  # 水源地
  waterSource: String
  # 矿物质含量
  mineralContent: String
  # 库存数量
  stock: Int!
  # 销量
  salesVolume: Int!
  # 商品状态
  status: ProductStatus!
  # 排序权重
  sortOrder: Int!
  # 商品标签
  tags: JsonArray
  # 商品详情内容
  detailContent: String
  # 证书图片列表
  certificateImages: JsonArray
  # 配送设置
  deliverySettings: JsonObject
  # 创建时间
  createdAt: LocalDateTime!
  # 更新时间
  updatedAt: LocalDateTime!
}

type Address {
  # 地址唯一标识ID
  id: PrimaryId!
  # 用户ID
  userId: PrimaryId!
  # 收货人姓名
  receiverName: String!
  # 收货人手机号
  phone: String!
  # 省份
  province: String!
  # 省份代码
  provinceCode: String
  # 城市
  city: String!
  # 城市代码
  cityCode: String
  # 区县
  district: String!
  # 区县代码
  districtCode: String
  # 详细地址
  detailAddress: String!
  # 经度
  longitude: Float
  # 纬度
  latitude: Float
  # 是否为默认地址
  isDefault: Boolean!
  # 创建时间
  createdAt: LocalDateTime!
  # 更新时间
  updatedAt: LocalDateTime!
}

type DeliveryAddress {
  # 配送地址唯一标识ID
  id: PrimaryId!
  # 用户ID
  userId: PrimaryId!
  # 收货人姓名
  receiverName: String!
  # 收货人手机号
  receiverPhone: String!
  # 省份
  province: String!
  # 城市
  city: String!
  # 区县
  district: String!
  # 详细地址
  detailAddress: String!
  # 经度
  longitude: Float
  # 纬度
  latitude: Float
  # 创建时间
  createdAt: LocalDateTime!
  # 更新时间
  updatedAt: LocalDateTime!
}

type Order {
  # 订单唯一标识ID
  id: PrimaryId!
  # 订单编号
  orderNo: String!
  # 下单用户
  user: User
  # 订购商品
  product: Product
  # 配送地址
  address: Address
  # 订购数量
  quantity: Int!
  # 订单金额（分）
  amount: Money!
  # 订单状态
  status: OrderStatus!
  # 支付方式
  paymentMethod: String
  # 支付交易流水号
  paymentTransactionId: String
  # 支付时间
  paymentTime: LocalDateTime
  # 配送员信息
  deliveryWorker: DeliveryWorker
  # 配送照片列表
  deliveryPhotos: [String!]
  # 是否自收（水钱已收/水票已扣）
  isSelfCollect: Boolean!
  # 收款方式
  paymentType: PaymentType
  # 开始配送时间
  deliveryStartedAt: LocalDateTime
  # 配送确认时间
  deliveryConfirmedAt: LocalDateTime
  # 订单完成时间
  completedAt: LocalDateTime
  # 订单备注
  remark: String
  # 创建时间
  createdAt: LocalDateTime!
  # 更新时间
  updatedAt: LocalDateTime!
}

type DeliveryWorker {
  # 配送员唯一标识ID
  id: PrimaryId!
  # 用户ID
  userId: PrimaryId!
  # 微信OpenID
  wechatOpenId: String!
  # 配送员姓名
  name: String!
  # 配送员手机号
  phone: String!
  # 配送员头像URL
  avatarUrl: String
  # 在线状态
  onlineStatus: DeliveryWorkerStatus!
  # 坐标位置（经纬度格式）
  coordinates: String
  # 当前位置描述
  currentLocation: String
  # 评分
  rating: BigDecimal
  # 总订单数
  totalOrders: Int!
  # 已完成订单数
  completedOrders: Int!
  # 平均评分
  averageRating: BigDecimal
  # 收入（分）
  earning: Money
  # 是否可接单
  isAvailable: Boolean!
  # 当前任务数（待配送订单数）
  currentTaskCount: Int!
  # 创建时间
  createdAt: LocalDateTime!
  # 更新时间
  updatedAt: LocalDateTime!
}

# 当日统计数据 - 用于配送员小程序
type TodayStatistics {
  # 今日总订单数
  totalOrders: Int!
  # 今日已完成订单数
  completedOrders: Int!
  # 今日待配送订单数
  unfinishedOrders: Int!
  # 今日收入（分）
  earningCents: Long!
}

# 每日统计数据
type DailyStat {
  # 日期（MM/dd格式）
  date: String!
  # 订单数
  orderCount: Int!
  # 营收金额（元）
  earning: Long!
}

# 一周统计数据
type WeekStatistics {
  # 每日统计数据列表
  dailyStats: [DailyStat!]!
  # 总订单数
  totalOrders: Int!
  # 总营收金额（元）
  totalEarning: Long!
}

type DeliveryArea {
  # 配送区域ID
  id: PrimaryId!
  # 配送区域名称
  name: String!
  # 省份
  province: String!
  # 城市
  city: String!
  # 区县
  district: String!
  # 是否启用
  enabled: Boolean!
}

type Region {
  # 区域ID
  id: PrimaryId!
  # 区域名称
  name: String!
  # 区域代码
  code: String!
  # 父级区域代码
  parentCode: String
  # 区域级别（1-省/2-市/3-区）
  level: Int!
  # 创建时间
  createdAt: LocalDateTime!
  # 更新时间
  updatedAt: LocalDateTime!
}

# Authentication Types
type AuthPayload {
  # 访问令牌
  accessToken: String!
  # 刷新令牌
  refreshToken: String!
  # 用户信息
  user: User!
}

type UserInfo {
  # 用户ID
  id: PrimaryId!
  # 微信OpenID
  wechatOpenId: String!
  # 用户昵称
  nickname: String
  # 用户手机号
  phone: String
  # 用户头像URL
  avatarUrl: String
  # 创建时间
  createdAt: LocalDateTime!
  # 更新时间
  updatedAt: LocalDateTime!
}

type Admin {
  # 管理员ID
  id: PrimaryId!
  # 用户名
  username: String!
  # 真实姓名
  realName: String
  # 手机号
  phone: String
  # 角色
  role: String!
  # 最后登录时间
  lastLoginAt: LocalDateTime
  # 创建时间
  createdAt: LocalDateTime!
  # 更新时间
  updatedAt: LocalDateTime!
}

type WeChatLoginResponse {
  # 访问令牌
  accessToken: String!
  # 刷新令牌
  refreshToken: String!
  # 过期时间（秒）
  expiresIn: Int!
  # 用户信息
  userInfo: UserInfo!
}

type WeChatTokenResponse {
  # 访问令牌
  accessToken: String!
  # 刷新令牌
  refreshToken: String!
  # 过期时间（秒）
  expiresIn: Int!
}

type PaymentData {
  # 支付二维码URL
  codeUrl: String!
  # 商户订单号
  outTradeNo: String!
  # 微信应用ID
  appId: String!
  # 时间戳
  timeStamp: String!
  # 随机字符串
  nonceStr: String!
  # 订单详情扩展字符串
  packageValue: String!
  # 签名方式
  signType: String!
  # 签名
  paySign: String!
}

# Statistics Types
type OrderStatistics {
  # 订单总数
  totalOrders: Int!
  # 总收入
  totalRevenue: Money!
  # 平均订单金额
  averageOrderValue: Money!
  # 日期范围
  dateRange: DateRange!
}

type DateRange {
  # 开始日期
  startDate: LocalDateTime!
  # 结束日期
  endDate: LocalDateTime!
}

type DailyStatistic {
  # 日期
  date: String!
  # 订单数量
  orderCount: Int!
  orderProductCount: Int!
  # 收入（单位：元）
  revenue: Float!
}

type WeeklyStatistic {
  # 周数
  weekNumber: Int!
  # 年份
  year: Int!
  # 开始日期
  startDate: String!
  # 结束日期
  endDate: String!
  # 订单数量
  orderCount: Int!
  orderProductCount: Int!
  # 收入
  revenue: Float!
}

type MonthlyStatistic {
  # 月份
  month: Int!
  # 年份
  year: Int!
  # 月份名称
  monthName: String!
  # 订单数量
  orderCount: Int!
  orderProductCount: Int!
  # 收入
  revenue: Float!
}

# Common Input Types
input DateRangeInput {
  startDate: LocalDateTime!
  endDate: LocalDateTime!
}

input RefreshTokenInput {
  refreshToken: String!
    @notBlank(message: "刷新令牌不能为空")
    @size(min: 10, max: 1000, message: "刷新令牌长度应在10-1000个字符之间")
}

input UpdateProfileInput {
  nickname: String @size(min: 2, max: 50, message: "昵称长度应在2-50个字符之间")
  phone: String
    @pattern(regexp: "^1[3-9]\\\\d{9}$", message: "手机号格式不正确")
  avatar: String @size(max: 500, message: "头像URL长度不能超过500个字符")
}

input UpdateAddressInput {
  receiverName: String
    @notBlank(message: "收货人姓名不能为空")
    @size(min: 2, max: 20, message: "收货人姓名长度应在2-20个字符之间")
  phone: String
    @notBlank(message: "收货人手机号不能为空")
    @pattern(regexp: "^1[3-9]\\\\d{9}$", message: "手机号格式不正确")
  province: String @notBlank(message: "省份不能为空")
  provinceCode: String
    @size(min: 1, max: 20, message: "省份代码长度应在1-20个字符之间")
  city: String @notBlank(message: "城市不能为空")
  cityCode: String
    @size(min: 1, max: 20, message: "城市代码长度应在1-20个字符之间")
  district: String @notBlank(message: "区县不能为空")
  districtCode: String
    @size(min: 1, max: 20, message: "区县代码长度应在1-20个字符之间")
  detailAddress: String
    @notBlank(message: "详细地址不能为空")
    @size(min: 5, max: 200, message: "详细地址长度应在5-200个字符之间")
  longitude: Float
    @min(value: -180, message: "经度不能小于-180")
    @max(value: 180, message: "经度不能大于180")
  latitude: Float
    @min(value: -90, message: "纬度不能小于-90")
    @max(value: 90, message: "纬度不能大于90")
  isDefault: Boolean
}

input AddressInput {
  receiverName: String!
    @notBlank(message: "收货人姓名不能为空")
    @size(min: 2, max: 20, message: "收货人姓名长度应在2-20个字符之间")
  phone: String!
    @notBlank(message: "收货人手机号不能为空")
    @pattern(regexp: "^1[3-9]\\\\d{9}$", message: "手机号格式不正确")
  province: String! @notBlank(message: "省份不能为空")
  provinceCode: String!
    @size(min: 1, max: 20, message: "省份代码长度应在1-20个字符之间")
  city: String! @notBlank(message: "城市不能为空")
  cityCode: String!
    @size(min: 1, max: 20, message: "城市代码长度应在1-20个字符之间")
  district: String! @notBlank(message: "区县不能为空")
  districtCode: String!
    @size(min: 1, max: 20, message: "区县代码长度应在1-20个字符之间")
  detailAddress: String!
    @notBlank(message: "详细地址不能为空")
    @size(min: 5, max: 200, message: "详细地址长度应在5-200个字符之间")
  longitude: Float
    @min(value: -180, message: "经度不能小于-180")
    @max(value: 180, message: "经度不能大于180")
  latitude: Float
    @min(value: -90, message: "纬度不能小于-90")
    @max(value: 90, message: "纬度不能大于90")
  isDefault: Boolean! = false
}

input CreateOrderInput {
  productId: PrimaryId! @positive(message: "商品ID必须为正数")
  addressId: PrimaryId! @positive(message: "地址ID必须为正数")
  quantity: Int!
    @min(value: 1, message: "购买数量不能少于1")
    @max(value: 999, message: "购买数量不能超过999")
  remark: String @size(max: 500, message: "备注长度不能超过500个字符")
}

# 配送员创建订单输入类型
input CreateDeliveryOrderInput {
  productId: PrimaryId! @positive(message: "商品ID必须为正数")
  addressId: PrimaryId! @positive(message: "地址ID必须为正数")
  quantity: Int!
    @min(value: 1, message: "购买数量不能少于1")
    @max(value: 999, message: "购买数量不能超过999")
  # 是否自收（水钱已收/水票已扣），默认 false
  isSelfCollect: Boolean = false
  remark: String @size(max: 500, message: "备注长度不能超过500个字符")
}

input WechatLoginInput {
  code: String!
    @notBlank(message: "微信授权码不能为空")
    @size(min: 10, max: 100, message: "授权码长度应在10-100个字符之间")
}

input CreateProductInput {
  name: String!
    @notBlank(message: "商品名称不能为空")
    @size(min: 2, max: 200, message: "商品名称长度应在2-200个字符之间")
  subtitle: String @size(max: 500, message: "商品副标题长度不能超过500个字符")
  price: Money!
    @positive(message: "商品价格必须为正数")
    @min(value: 1, message: "商品价格不能小于1分")
    @max(value: 9999900, message: "商品价格不能大于99999元")
  originalPrice: Money
    @positive(message: "原价必须为正数")
    @min(value: 1, message: "原价不能小于1分")
    @max(value: 9999900, message: "原价不能大于99999元")
  depositPrice: Money
    @min(value: 0, message: "押金不能小于0")
    @max(value: 9999900, message: "押金不能大于99999元")
  coverImageUrl: String!
    @notBlank(message: "商品封面图片不能为空")
    @size(max: 500, message: "封面图片URL长度不能超过500个字符")
  imageGallery: JsonArray
  specification: String!
    @notBlank(message: "商品规格不能为空")
    @size(min: 1, max: 100, message: "商品规格长度应在1-100个字符之间")
  waterSource: String @size(max: 200, message: "水源地长度不能超过200个字符")

  mineralContent: String
    @size(max: 200, message: "矿物质含量长度不能超过200个字符")
  stock: Int!
    @min(value: 0, message: "库存数量不能小于0")
    @max(value: 99999, message: "库存数量不能大于99999")
  salesVolume: Int! @min(value: 0, message: "销量不能小于0")
  status: ProductStatus!
  sortOrder: Int!
    @min(value: 0, message: "排序权重不能小于0")
    @max(value: 9999, message: "排序权重不能大于9999")
  tags: JsonArray
  detailContent: String
    @size(max: 5000, message: "详情内容长度不能超过5000个字符")
  certificateImages: JsonArray
  deliverySettings: JsonObject
}

input UpdateProductInput {
  name: String
    @size(min: 2, max: 200, message: "商品名称长度应在2-200个字符之间")
  subtitle: String @size(max: 500, message: "商品副标题长度不能超过500个字符")
  price: Money
    @positive(message: "商品价格必须为正数")
    @min(value: 1, message: "商品价格不能小于1分")
    @max(value: 9999900, message: "商品价格不能大于99999元")
  originalPrice: Money
    @positive(message: "原价必须为正数")
    @min(value: 1, message: "原价不能小于1分")
    @max(value: 9999900, message: "原价不能大于99999元")
  depositPrice: Money
    @min(value: 0, message: "押金不能小于0")
    @max(value: 9999900, message: "押金不能大于99999元")
  coverImageUrl: String
    @size(max: 500, message: "封面图片URL长度不能超过500个字符")
  imageGallery: JsonArray
  specification: String
    @size(min: 1, max: 100, message: "商品规格长度应在1-100个字符之间")
  waterSource: String @size(max: 200, message: "水源地长度不能超过200个字符")

  mineralContent: String
    @size(max: 200, message: "矿物质含量长度不能超过200个字符")
  stock: Int
    @min(value: 0, message: "库存数量不能小于0")
    @max(value: 99999, message: "库存数量不能大于99999")
  salesVolume: Int @min(value: 0, message: "销量不能小于0")
  status: ProductStatus
  sortOrder: Int
    @min(value: 0, message: "排序权重不能小于0")
    @max(value: 9999, message: "排序权重不能大于9999")
  tags: JsonArray
  detailContent: String
    @size(max: 5000, message: "详情内容长度不能超过5000个字符")
  certificateImages: JsonArray
  deliverySettings: JsonObject
}

input CreateWechatPaymentInput {
