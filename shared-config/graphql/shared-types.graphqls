# Delivery Worker Authentication Types
input DeliveryLoginInput {
  code: String!
}

input BindDeliveryPhoneInput {
  openId: String!
  phoneNumber: String!
}

type DeliveryLoginResponse {
  token: String
  refreshToken: String
  needBindPhone: Boolean!
  workerInfo: DeliveryWorkerInfo
  message: String
  openId: String
}

type DeliveryWorkerInfo {
  id: ID!
  name: String!
  phone: String!
  avatarUrl: String
  wechatOpenId: String!
}

# 用户统计
type UserStatistics {
  # 总用户数
  totalUsers: Int!
  # 今日新增用户数
  todayNewUsers: Int!
  # 本月新增用户数
  monthNewUsers: Int!
  # 活跃用户数（30天内有下单）
  activeUsers: Int!
  # 每日新增用户趋势
  dailyNewUsers: [DailyStatistic!]!
  # 登录统计
  loginStatistics: LoginStatistics
  # 下单用户分布(近30天,G35):下单次数分层 + 下单用户占比 + 复购率
  orderDistribution: OrderUserDistribution!
}

# 下单用户分布(F-STA-003,G35):按近30天下单用户去重聚合
type OrderUserDistribution {
  # 下单用户数(近30天下单用户去重)
  orderingUsers: Int!
  # 下单用户占比 = 下单用户数 / 总用户数(0..1,总用户数为 0 时为 0)
  orderingUserRatio: Float!
  # 复购率 = 下单≥2次用户数 / 下单用户数(0..1,无下单用户时为 0)
  repurchaseRate: Float!
  # 下单次数分层(1次/2~3次/4次以上)
  tiers: [OrderUserTier!]!
}

# 下单次数分层项(F-STA-003,G35)
type OrderUserTier {
  # 分层标签:1次 / 2~3次 / 4次以上
  label: String!
  # 该分层用户数
  userCount: Int!
}

# 用户登录统计
type LoginStatistics {
  # 今日登录用户数
  todayLogins: Int!
  # 累计登录用户数
  totalLogins: Int!
  # 每日登录趋势
  dailyLogins: [DailyLoginStatistic!]!
}

# 每日登录统计
type DailyLoginStatistic {
  # 日期
  date: String!
  # 登录用户数
  loginCount: Int!
}

# 送水员概览统计
type DeliveryWorkerOverview {
  # 送水员总数
  totalWorkers: Int!
  # 今日在岗送水员数
  todayActiveWorkers: Int!
  # 今日配送中订单数
  deliveringOrders: Int!
  # 今日已完成订单数
  todayCompletedOrders: Int!
  # 人均单量 = 今日完成订单总数 / 今日在岗送水员数(在岗为 0 时为 null,G36)
  averageOrdersPerWorker: Float
  # 平均履约时长(分钟)= Σ(completedAt − 派单时间) / 今日完成订单数;无完成订单时为 null(G36)
  averageFulfillmentMinutes: Float
}

# 送水员排行
type DeliveryWorkerRankingItem {
  # 送水员ID
  workerId: ID!
  # 送水员姓名
  name: String!
  # 今日完成订单数
  todayCompletedOrders: Int!
  # 好评率
  rating: Float!
  # 累计收入（分）
  totalEarningsCents: Long!
}

# 每日收款记录状态枚举
enum DailyCollectionStatus {
  DRAFT      # 草稿（配送员刚录入）
  SUBMITTED  # 已提交（待管理员确认）
  CONFIRMED  # 已确认（管理员已确认）
  DISPUTED   # 有争议（金额不匹配）
}

# 每日对账记录状态枚举
enum DailyReconciliationStatus {
  PENDING      # 待对账
  MATCHED      # 匹配（差异在容差范围内）
  DISCREPANCY  # 有差异（超出容差范围）
  REVIEWED     # 已人工复核
}

# 每日收款记录
type DailyCollectionRecord {
  # 记录ID
  id: PrimaryId!
  # 配送员ID
  deliveryWorkerId: PrimaryId!
  # 收款日期
  collectionDate: String!
  # 现金收款金额（分）
  cashAmountCents: Long!
  # 水票数量
  waterTicketCount: Int!
  # 扫码收款金额（分）
  qrCodeAmountCents: Long!
  # 订单数量
  orderCount: Int!
  # 订单金额合计（分）
  orderAmountCents: Long!
  # 差异金额（分）
  differenceAmountCents: Long!
  # 系统计算的现金金额（分）
  calculatedCashAmountCents: Long!
  # 系统计算的扫码金额（分）
  calculatedQrCodeAmountCents: Long!
  # 系统计算的水票数量
  calculatedWaterTicketCount: Int!
  # 系统计算的订单金额（分）
  calculatedOrderAmountCents: Long!
  # 状态
  status: DailyCollectionStatus!
  # 确认时间
  confirmedAt: LocalDateTime
  # 确认人ID
  confirmedBy: PrimaryId
  # 备注(配送员差异说明,超容差时必填 —— G28/G30)
  notes: String
  # 驳回时间(管理员驳回争议日报 —— G28)
  rejectedAt: LocalDateTime
  # 驳回人ID
  rejectedBy: PrimaryId
  # 驳回原因
  rejectReason: String
  # 创建时间
  createdAt: LocalDateTime!
  # 更新时间
  updatedAt: LocalDateTime!
}

# 配送员今日收款预计算结果（返回给配送员小程序）
type MyTodayCollectionVO {
  # 今日完成订单数（系统自动计算）
  orderCount: Int!
  # 今日订单金额合计（系统自动计算，单位：分）
  orderAmountCents: Long!
  # 配送员已填写的现金收款金额（分）
  cashAmountCents: Long
  # 配送员已填写的水票数量
  waterTicketCount: Int
  # 配送员已填写的扫码收款金额（分）
  qrCodeAmountCents: Long
  # 差异金额（分）
  differenceAmountCents: Long
  # 系统计算的现金应收金额（分）- 从订单支付统计得出
  calculatedCashAmountCents: Long
  # 系统计算的扫码应收金额（分）- 从订单支付统计得出
  calculatedQrCodeAmountCents: Long
  # 系统计算的水票应收数量 - 从订单支付统计得出
  calculatedWaterTicketCount: Int
  # 系统计算的订单金额合计（分）
  calculatedOrderAmountCents: Long
  # 记录状态
  status: DailyCollectionStatus
}

# 每日对账记录
type DailyReconciliation {
  # 记录ID
  id: PrimaryId!
  # 对账日期
  reconciliationDate: String!
  # 现金总收款（分）
  totalCashAmountCents: Long!
  # 水票总数
  totalWaterTicketCount: Int!
  # 扫码总金额（分）
  totalQrCodeAmountCents: Long!
  # 订单总数
  totalOrderCount: Int!
  # 订单总金额（分）
  totalOrderAmountCents: Long!
  # 收款总金额（分）
  totalCollectionAmountCents: Long!
  # 差异金额（分）
  discrepancyAmountCents: Long!
  # 状态
  status: DailyReconciliationStatus!
  # 报表数据
  reportData: JsonObject
  # 复核时间
  reviewedAt: LocalDateTime
  # 复核人ID
  reviewedBy: PrimaryId
  # 复核备注
  reviewNotes: String
  # 创建时间
  createdAt: LocalDateTime!
  # 更新时间
  updatedAt: LocalDateTime!
}

# 提交每日收款输入
input SubmitDailyCollectionInput {
  # 现金收款金额（分）
  cashAmountCents: Long!
  # 水票数量
  waterTicketCount: Int!
  # 扫码收款金额（分）
  qrCodeAmountCents: Long!
  # 收款日期（可选，默认今天）
  collectionDate: String
  # 差异说明（超出容差时填写）
  notes: String
}

# 确认每日收款输入
input ConfirmDailyCollectionInput {
  # 记录ID
  recordId: PrimaryId!
  # 备注
  notes: String
}

# 驳回每日收款输入(G28:管理员驳回争议/待确认日报,退回草稿可改可重提)
input RejectDailyCollectionInput {
  # 记录ID
  recordId: PrimaryId!
  # 驳回原因(必填)
  reason: String!
}

# 复核对账记录输入
input ReviewReconciliationInput {
  # 对账记录ID
  reconciliationId: PrimaryId!
  # 复核备注
  reviewNotes: String!
}

# ==================== 运营配置域(OPS) ====================
# 与 PRD 12-operations-config.md 保持一致;共享类型供 admin/client 两端使用

# 轮播图(运营位)
type Banner {
  # 主键
  id: PrimaryId!
  # 图片地址(平台存储服务上传素材)
  imageUrl: String!
  # 标题(≤20字)
  title: String!
  # 副标题
  subtitle: String
  # 跳转类型
  linkType: BannerLinkType!
  # 跳转目标(PRODUCT 为商品ID,CUSTOM_PAGE 为页面路径)
  linkTarget: String!
  # 排序号
  sortOrder: Int!
  # 是否启用
  enabled: Boolean!
  # 时间窗开始(空=长期)
  startAt: LocalDateTime
  # 时间窗结束(空=长期)
  endAt: LocalDateTime
  # 创建时间
  createdAt: LocalDateTime!
  # 更新时间
  updatedAt: LocalDateTime!
}

# 轮播跳转链接类型
enum BannerLinkType {
  # 商品详情
  PRODUCT
  # 自定义页面
  CUSTOM_PAGE
}

# 意见反馈类型
enum FeedbackType {
  # 产品质量问题
  PRODUCT_QUALITY
  # 配送服务问题
  DELIVERY_SERVICE
  # 小程序使用问题
  APP_USAGE
  # 功能建议
  SUGGESTION
  # 投诉建议
  COMPLAINT
  # 其他问题
  OTHER
}

# 反馈处理状态
enum FeedbackStatus {
  # 待处理
  PENDING
  # 处理中
  PROCESSING
  # 已处理
  RESOLVED
}

# 公告 (F-OPS-002)
type Notice {
  # 主键
  id: PrimaryId!
  # 标题(≤50字)
  title: String!
  # 内容(≤2000字)
  content: String!
  # 类型
  type: NoticeType!
  # 是否置顶(置顶公告在公告栏最前展示)
  pinned: Boolean!
  # 时间窗开始(空=长期)
  startAt: LocalDateTime
  # 时间窗结束(空=长期)
  endAt: LocalDateTime
  # 状态(草稿/已发布/已停用)
  status: NoticeStatus!
  # 发布时间(每次发布重置为当前时间)
  publishedAt: LocalDateTime
  # 创建时间
  createdAt: LocalDateTime!
  # 更新时间
  updatedAt: LocalDateTime!
}

# 公告类型
enum NoticeType {
  # 平台公告
  PLATFORM_NOTICE
  # 停水通知
  WATER_OUTAGE
  # 活动预告
  ACTIVITY_PREVIEW
}

# 公告状态
enum NoticeStatus {
  # 草稿
  DRAFT
  # 已发布
  PUBLISHED
  # 已停用
  STOPPED
}

# 店铺信息 (F-OPS-004,单行配置;未配置时用户端按默认值兜底)
type StoreProfile {
  # 店铺名称(≤20字)
  shopName: String!
  # LOGO 图片地址
  logoUrl: String
  # 客服电话
  serviceHotline: String!
  # 营业开始时间("HH:mm")
  businessHoursStart: String
  # 营业结束时间("HH:mm")
  businessHoursEnd: String
  # 店铺简介(≤100字)
  shopIntro: String
  # 关于我们文案(≤2000字)
  aboutUs: String
  # 更新时间
  updatedAt: LocalDateTime
}

# 配送费规则 (F-OPS-005;楼层口径,未配置按默认 免费4楼/加价2元)
type DeliveryFeeRule {
  # 免费楼层(楼层 ≤ 该值免运费)
  freeFloorLimit: Int!
  # 超出免费楼层的一次性加价(分,0-99900)
  surchargeCents: Long!
  # 更新时间
  updatedAt: LocalDateTime
}

# ==================== 营销域(MKT,PRD 10-marketing.md) ====================
# 营销域共享枚举(管理后台与用户端共用)

# 优惠券类型(R-MKT-03)
enum CouponType {
  # 现金券(满X减Y)
  CASH
  # 折扣券(满X打N折)
  DISCOUNT
  # 无门槛现金券
  NO_THRESHOLD_CASH
}

# 营销适用范围
enum CouponScope {
  # 全场
  ALL
  # 指定商品
  PRODUCT
}

# 有效期类型
enum ValidityType {
  # 固定区间
  FIXED_RANGE
  # 领取后N天(优惠券)
  DAYS_AFTER_CLAIM
  # 购票后N天(桶水票)
  DAYS_AFTER_PURCHASE
}

# 桶水票票种类型(R-MKT-08)
enum TicketTypeKind {
  # 指定商品票(仅抵指定商品)
  SPECIFIC_PRODUCT
  # 通兑票(抵限定规格下全场商品,跨规格不通用)
  UNIVERSAL
}

# 成交单价来源(R-MKT-01)
enum PriceSource {
  # 商品目录价
  CATALOG_PRICE
  # 客户分组商品专属价(熟客价)
  GROUP_PRICE
  # 限时特价活动价(R-MKT-05,单价链③)
  FLASH_SALE_PRICE
  # 新人专享价(R-MKT-10,单价链④)
  NEWCOMER_PRICE
  # 送水工代客下单手动实收价(预留)
  MANUAL
}

# ==================== 用户持有券/票(管理后台与用户端共用) ====================
# 用户持有的优惠券(F-MKT-003;管理后台用户详情页「优惠券」Tab 与用户端「我的券包」共用)
type UserCouponVO {
  id: PrimaryId!
  name: String!
  couponType: CouponType!
  thresholdCents: Long
  discountAmountCents: Long
  discountRatePermille: Long
  scope: CouponScope!
  productId: PrimaryId
  status: UserCouponStatus!
  expireTime: LocalDateTime!
  # 当前订单上下文是否可用(引擎计算,门槛不足/过期置灰;后台列表恒 false)
  usable: Boolean!
}

enum UserCouponStatus {
  RECEIVED
  USED
  RETURNED
  EXPIRED
}

# 用户持有的桶水票(F-MKT-007;管理后台用户详情页「水票」Tab 与用户端「我的水票」共用)
type UserTicketVO {
  id: PrimaryId!
  # 水票唯一递增票号(SP+入账年月+8位序号,按月重置;用户可见,长按可复制)
  ticketNo: String!
  # 票种名称
  ticketTypeName: String!
  # 通兑票限定规格
  specification: String
  status: UserTicketStatus!
  expireTime: LocalDateTime!
  # 是否赠送票
  isGift: Boolean!
}

enum UserTicketStatus {
  UNUSED
  USED
  RETURNED
  EXPIRED
}
# ============ 通知与消息(PRD 13-notification.md F-NTF-002/004/006,两个服务共用) ============

# 站内消息分类(消息中心 Tab:全部/订单/公告/反馈;公告与反馈聚合为开放问题,枚举预留)
enum NotificationType {
  ORDER
  SYSTEM
  ANNOUNCEMENT
  FEEDBACK
}

# 站内消息
type NotificationVO {
  id: PrimaryId!
  type: NotificationType!
  # 接收人类型(USER/WORKER,后台消息列表展示)
  receiverType: NotificationReceiverType!
  # 触发场景(领域事件名,如 ORDER_PAID)
  scene: String!
  title: String!
  summary: String
  # 关联单号(订单 id)
  relatedNo: String
  # 是否已读
  read: Boolean!
  readAt: LocalDateTime
  createdAt: LocalDateTime!
}

# 站内消息分页
type NotificationVOPage {
  content: [NotificationVO!]!
  totalElements: Int!
  totalPages: Int!
  size: Int!
  number: Int!
}

# 订阅消息模板配置项(R-NTF-01,下单确认页订阅授权用)
type SubscribeTemplateVO {
  scene: String!
  templateId: String!
  enabled: Boolean!
}

# 通知接收人类型(后台消息列表筛选,F-NTF-006)
enum NotificationReceiverType {
  USER
  WORKER
}
