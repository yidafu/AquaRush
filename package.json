{
  "name": "aquarush",
  "version": "1.0.0",
  "description": "<div align=\"center\">   <img src=\"aqua-rush-logo.svg\" alt=\"AquaRush Logo\" width=\"240\"/>   <h1>AquaRush - WeChat Bottled Water Ordering System</h1> </div>",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "dev:pc": "cd frontend/admin-client && npm run dev",
    "dev:weapp": "cd frontend/user-weapp && npm run dev:weapp",
    "dev:client": "./gradlew :services:aqua-client:bootRun",
    "dev:admin": "./gradlew :services:aqua-admin:bootRun",
    "dev": "run-p dev:*",
    "test": "echo \"Error: no test specified\" && exit 1",
    "test:frontend": "pnpm --filter @aquarush/common test && pnpm --filter @aquarush/admin-client test && pnpm --filter user-miniapp test && pnpm --filter delivery-app test",
    "test:frontend:coverage": "pnpm --filter @aquarush/common test:coverage && pnpm --filter @aquarush/admin-client test:coverage && pnpm --filter user-miniapp test:coverage && pnpm --filter delivery-app test:coverage",
    "codegen": "graphql-codegen --config graphql-codegen.yml"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yidafu/AquaRush.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/yidafu/AquaRush/issues"
  },
  "homepage": "https://github.com/yidafu/AquaRush#readme",
  "dependencies": {
    "@graphql-codegen/cli": "^6.1.0",
    "@graphql-codegen/kotlin": "^3.0.2",
    "@graphql-codegen/kotlin-validation": "workspace:*",
    "@graphql-codegen/typescript": "^5.0.5",
    "@graphql-codegen/typescript-resolvers": "^5.1.3",
    "@graphql-codegen/visitor-plugin-common": "^6.2.1",
    "graphql": "^16.12.0"
  },
  "overrides": {
    "graphql": "^16.12.0"
  },
  "pnpm": {
    "overrides": {
      "graphql": "^16.12.0"
    },
    "patchedDependencies": {
      "react-native-wechat-lib": "patches/react-native-wechat-lib.patch",
      "react-native-fitness-geolocation": "patches/react-native-fitness-geolocation.patch"
    }
  },
  "devDependencies": {
    "@graphql-codegen/typescript-operations": "^5.0.6",
    "@graphql-codegen/typescript-react-apollo": "^4.3.3",
    "npm-run-all": "^4.1.5"
  },
  "browserslist": {
    "development": [
      "defaults and fully supports es6-module",
      "maintained node versions"
    ],
    "production": [
      "defaults and fully supports es6-module",
      "maintained node versions"
    ]
  }
}