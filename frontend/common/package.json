  "author": "AquaRush Team",
  "license": "ISC",
  "dependencies": {
    "taro-ui": "^3.3.0"
  },
  "devDependencies": {
    "@babel/core": "^7.28.5",
    "@babel/preset-env": "^7.28.5",
    "@babel/preset-typescript": "^7.28.5",
    "@jest/globals": "^29.7.0",
    "@types/jest": "^29.5.14",
    "@types/react": "^19.2.2",
    "babel-jest": "^29.7.0",
    "jest": "^29.7.0"
  }
