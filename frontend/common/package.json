{
  "name": "@aquarush/common",
  "version": "1.0.0",
  "description": "Common types and utilities for AquaRush frontend applications",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "type": "module",
  "peerDependencies": {
    "@tarojs/taro": "4.1.9",
    "react": ">=18"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./utils": {
      "types": "./src/utils/index.ts",
      "import": "./src/utils/index.ts"
    },
    "./utils/money": {
      "types": "./src/utils/money.ts",
      "import": "./src/utils/money.ts"
    },
    "./utils/network": {
      "types": "./src/utils/network.ts",
      "import": "./src/utils/network.ts"
    },
    "./types": {
      "types": "./src/types/index.ts",
      "import": "./src/types/index.ts"
    },
    "./types/graphql": {
      "types": "./src/types/graphql.ts",
      "import": "./src/types/graphql.ts"
    },
