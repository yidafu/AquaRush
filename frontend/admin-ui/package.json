{
  "name": "@aquarush/admin-ui",
  "version": "1.0.0",
  "private": true,
  "description": "AquaRush admin 后台 headless 组件库(Radix UI 封装 + StyleX 样式)",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./icons": {
      "types": "./src/icons/index.tsx",
      "import": "./src/icons/index.tsx",
      "default": "./src/icons/index.tsx"
    },
    "./test-utils": {
      "types": "./src/test-utils.tsx",
      "import": "./src/test-utils.tsx",
      "default": "./src/test-utils.tsx"
    }
  },
  "scripts": {
    "test": "jest",
    "test:coverage": "jest --coverage",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json"
  },
  "keywords": [
    "aquarush",
    "admin",
    "ui",
    "radix",
    "stylex"
  ],
  "license": "AGPL-3.0",
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "@aquarush/common": "workspace:*",
    "@radix-ui/react-checkbox": "^1.3.12",
    "@radix-ui/react-dialog": "^1.2.0",
    "@radix-ui/react-dropdown-menu": "^2.1.25",
    "@radix-ui/react-popover": "^1.2.0",
    "@radix-ui/react-radio-group": "^1.4.8",
    "@radix-ui/react-select": "^2.3.8",
    "@radix-ui/react-slider": "^1.5.0",
    "@radix-ui/react-switch": "^1.3.8",
    "@radix-ui/react-tabs": "^1.1.22",
    "@radix-ui/react-tooltip": "^1.3.0",
    "@stylexjs/stylex": "^0.19.1",
    "@tanstack/react-table": "^9.2.8",
    "dayjs": "^1.11.20",
    "react-day-picker": "^10.0.2",
    "react-hook-form": "^7.89.0"
  },
  "devDependencies": {
    "@babel/core": "^7.28.5",
    "@babel/preset-env": "^7.28.5",
    "@babel/preset-react": "^7",
    "@babel/preset-typescript": "^7.28.5",
    "@eslint/js": "^9.39.1",
    "@jest/globals": "^29.7.0",
    "@stylexjs/babel-plugin": "0.19.1",
    "@types/jest": "^29.5.14",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "babel-jest": "^29.7.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4"
  }
}
