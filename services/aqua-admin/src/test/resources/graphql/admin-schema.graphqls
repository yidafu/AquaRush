# Aqua AdminVo GraphQL Schema
# Schema for the AdminVo dashboard and delivery worker management

# Extend shared schema
# The shared types are imported from shared-config/graphql/shared-types.graphqls

# Schema definition
schema {
  query: Query
  mutation: Mutation
}

# AdminVo-specific Query Schema
type Query {
  # AdminVo queries - AdminVo only
  admins(keyword: String, role: String, page: Int = 0, size: Int = 20): AdminVoPage!
  admin(id: PrimaryId!): AdminVo

  # UserVo management - AdminVo only
  users(input: UserListInput): UserVoPage!
  user(id: PrimaryId!): UserVo

  # Delivery Worker queries
  deliveryWorkers(keyword: String, role: String, page: Int = 0, size: Int = 20): DeliveryWorkerVoPage!
  onlineDeliveryWorkers: [DeliveryWorkerVo!]!
  deliveryWorker(id: PrimaryId!): DeliveryWorkerVo

  # Addresses (for admin management)
  userAddresses(userId: Long): [AddressVo!]!
  address(id: PrimaryId!): AddressVo
  searchUserAddresses(keyword: String!, userId: Long, page: Int = 0, size: Int = 10): [AddressVo!]!
  searchAllAddresses(keyword: String, page: Int = 0, size: Int = 10): AddressVoPage!
  deliveryAddresses: [DeliveryAddressVo!]!
  deliveryAddress(id: PrimaryId!): DeliveryAddressVo

  # Products (AdminVo management)
  product(id: PrimaryId!): ProductVo
  productStatistics(dateRange: DateRangeInput): ProductStatisticsVo
  productDailySales(input: DateRangeInput!): [ProductDailySalesVo!]!
  productSalesTrend(input: ProductSalesTrendInput!): ProductSalesTrend
  lowStockProducts(threshold: Int = 10): [LowStockAlert!]!
  productsPaginated(input: ProductSearchInput): ProductVoPage

  # Enhanced ProductVo Management Queries
  topSalesProducts(limit: Int = 10): [ProductVo!]!
  activeProducts(keyword: String, page: Int = 0, size: Int = 20): ProductVoPage!

  # Orders (AdminVo/Delivery perspective)
  order(orderId: PrimaryId!): OrderVo
  orderByNo(orderNo: String!): OrderVo
  orders(input: OrderListInput): OrderVoPage
  orderOperations(orderId: PrimaryId!): [OrderOperationVo!]!

  # 派单相关查询
  pendingDeliveryOrders: [OrderVo!]!              # 待派单订单
  assignedOrders: [OrderVo!]!  # 已分配订单
  deliveringOrders: [OrderVo!]! # 配送中订单

  # 配送员历史订单查询（已完成、已取消、已退款）
  deliveryWorkerHistoryOrders(
    status: OrderStatus
    keyword: String
    page: Int = 0
    size: Int = 20
  ): OrderVoPage!

  # 当日统计数据
  todayStatistics: TodayStatisticsVo

  # 一周统计数据
  weekStatistics: WeekStatisticsVo

  # 每日收款查询
  dailyCollections(collectionDate: String): [DailyCollectionRecordVo!]!
  dailyReconciliations: [DailyReconciliationVo!]!
  dailyReconciliation(reconciliationDate: String!): DailyReconciliationVo
  # 配送员今日收款 - 获取今日收款预计算结果（订单统计）
  myTodayCollection: MyTodayCollectionVo

  # 用户搜索
  findUserByPhone(phone: String!): UserVo
  findUsersByAddress(address: String!): [UserVo!]!

  # Payment queries (AdminVo perspective)
  paymentStatus(transactionId: String!): String!
  paymentTransaction(id: String!): PaymentTransactionVo
  paymentTransactions(
    page: Int = 0
    size: Int = 20
    userId: Long
    status: PaymentStatus
    dateFrom: LocalDateTime
    dateTo: LocalDateTime
    minAmount: BigDecimal
    maxAmount: BigDecimal
  ): [PaymentTransactionVo!]!
  userPaymentTransactions(userId: PrimaryId!, page: Int = 0, size: Int = 20): [PaymentTransactionVo!]!
  refundRequests(
    page: Int = 0
    size: Int = 20
    status: RefundStatus
    dateFrom: LocalDateTime
    dateTo: LocalDateTime
  ): [RefundRequestVo!]!
  refundRequest(id: String!): RefundRequestVo
  suspiciousTransactions(
    page: Int = 0
    size: Int = 20
    dateFrom: LocalDateTime
    dateTo: LocalDateTime
  ): [SuspiciousTransactionVo!]!

  # Statistics and Analytics - AdminVo only
  orderStatistics(input: DateRangeInput!): OrderStatisticsVo!
  dailyStatistics(input: DateRangeInput!): [DailyStatisticVo!]!
  weeklyStatistics(input: DateRangeInput!): [WeeklyStatisticVo!]!
  monthlyStatistics(input: DateRangeInput!): [MonthlyStatisticVo!]!

  # UserVo Statistics - AdminVo only
  userStatistics: UserStatisticsVo!

  # Delivery Worker Statistics - AdminVo only
  deliveryWorkerStatistics: DeliveryWorkerOverviewVo!
  deliveryWorkerRanking(limit: Int = 10): [DeliveryWorkerRankingItemVo!]!

  # Regions (for admin)
  regions(level: Int, parentCode: String): [RegionVo!]!
  region(code: String!): RegionVo
  # 获取所有地区数据，用于前端构建树形结构
  regions(parentCode: String): [RegionVo!]!

  # AdminVo review queries
  reviews(
    deliveryWorkerId: Long
    minRating: Int
    maxRating: Int
    dateFrom: LocalDateTime
    dateTo: LocalDateTime
    userId: Long
    page: Int
    size: Int
  ): [ReviewVo!]!

  # AdminVo UserVo Favorites Management - AdminVo only
  allProductsFavoriteStats: AllProductsFavoriteStatsVo!
  productsByFavorites(page: Int = 0, size: Int = 20, minFavorites: Int): ProductFavoriteVoPage!
}

# AdminVo-specific Mutation Schema
type Mutation {
  # ProductVo Management - AdminVo only
  createProduct(input: CreateProductInput!): ProductVo!
  updateProduct(id: PrimaryId!, input: UpdateProductInput!): ProductVo!
  deleteProduct(id: PrimaryId!): Boolean!
  increaseStock(productId: PrimaryId!, quantity: Int!): String!
  decreaseStock(productId: PrimaryId!, quantity: Int!): Boolean!
  batchUpdateProducts(input: [ProductUpdateRequest!]!): [ProductVo!]!
  updateProductStatus(productId: PrimaryId!, status: ProductStatus!): ProductVo!

  # Enhanced ProductVo Management Mutations
  onlineProduct(id: PrimaryId!): ProductVo!
  offlineProduct(id: PrimaryId!): ProductVo!
  batchAdjustStock(input: BatchStockAdjustmentInput!): BatchStockAdjustmentResult!

  # OrderVo Management - AdminVo/Delivery operations
  updateOrderStatus(orderId: PrimaryId!, status: OrderStatus!): OrderVo!
  createDeliveryOrder(input: CreateDeliveryOrderInput!): OrderVo!  # 配送员创建订单

  # 派单管理
  assignDeliveryWorker(orderId: PrimaryId!, workerId: PrimaryId!, isSelfCollect: Boolean!): OrderVo!
  batchAssignOrders(orderIds: [PrimaryId!]!, workerId: PrimaryId!): [OrderVo!]!

  # 配送员操作
  acceptDelivery(orderId: PrimaryId!): OrderVo!           # 配送员接单
  startDelivery(orderId: PrimaryId!): OrderVo!             # 开始配送
  completeDelivery(orderId: PrimaryId!, photos: [String!]!, paymentType: PaymentType, remark: String): OrderVo!  # 完成配送

  # Payment Management - AdminVo operations
  handleWechatCallback(input: WechatCallbackInput!): String!
  refund(input: RefundInput!): Boolean!
  processRefund(input: ProcessRefundInput!): RefundRequestVo!
  createManualRefund(input: CreateManualRefundInput!): RefundRequestVo!
  forceCompletePayment(transactionId: String!, adminNote: String!): Boolean!
  forceRefund(transactionId: String!, amount: BigDecimal!, reason: String!, adminNote: String!): Boolean!
  updateTransactionNote(transactionId: String!, note: String!): Boolean!
  freezeSuspiciousTransaction(transactionId: String!, reason: String!): Boolean!
  exportTransactions(input: ExportTransactionsInput!): String!
  updateTransaction(transactionId: String!, input: UpdateTransactionInput!): PaymentTransactionVo!
  processSuspiciousTransaction(input: ProcessSuspiciousTransactionInput!): SuspiciousTransactionVo!

  # Delivery Area Management - AdminVo only
  createDeliveryArea(input: CreateDeliveryAreaInput!): DeliveryAreaVo!
  updateDeliveryArea(id: PrimaryId!, input: CreateDeliveryAreaInput!): DeliveryAreaVo!
  deleteDeliveryArea(id: PrimaryId!): Boolean!

  # Delivery Worker Management - AdminVo only
  createDeliveryWorker(input: CreateDeliveryWorkerInput!): DeliveryWorkerVo!
  updateDeliveryWorker(workerId: PrimaryId!, input: UpdateDeliveryWorkerInput!): DeliveryWorkerVo!
  updateWorkerStatus(workerId: PrimaryId!, status: DeliveryWorkerStatus!): DeliveryWorkerVo!

  # 每日收款管理
  submitDailyCollection(input: SubmitDailyCollectionInput!): DailyCollectionRecordVo!
  confirmDailyCollection(input: ConfirmDailyCollectionInput!): DailyCollectionRecordVo!
  reviewReconciliation(input: ReviewReconciliationInput!): DailyReconciliationVo!
  executeDailyReconciliation(reconciliationDate: String): DailyReconciliationVo!

  # AdminVo UserVo Favorites Management - AdminVo only
  batchFavoriteOperation(input: BatchFavoriteOperationInput!): BatchOperationVo!
  exportFavorites(input: ExportFavoritesInput!): ExportFavoritesVo!

  # AdminVo UserVo Management
  createAdmin(input: CreateAdminInput!): AdminVo!
  updateAdmin(id: PrimaryId!, input: UpdateAdminInput!): AdminVo!
  deleteAdmin(id: PrimaryId!): Boolean!

  # AdminVo AddressVo Management
  createAdminAddress(input: AddressInput!): AddressVo!
  batchImportAddresses(input: [AddressInput!]!): BatchImportAddressesVo!
  deleteAdminAddress(id: PrimaryId!): Boolean!
}

# AdminVo UserVo Input Types
input CreateAdminInput {
  username: String!
  password: String
  realName: String
  phone: String
  role: AdminRole!
  avatarUrl: String
  status: DeliveryWorkerStatus
  isAvailable: Boolean
}

input UpdateAdminInput {
  username: String
  realName: String
  phone: String
  role: AdminRole
  avatarUrl: String
  status: DeliveryWorkerStatus
  isAvailable: Boolean
}

# Extend the UserVo type with admin-specific fields
extend type UserVo {
  status: UserStatus!
  role: UserRole!
  email: String!
  balanceCents: Long!
  totalSpentCents: Long!
}

# Batch Import Result Types
type BatchImportAddressesVo {
  successCount: Int!
  failureCount: Int!
  totalCount: Int!
}

# 地址分页
type AddressVoPage {
  content: [AddressVo!]!
  totalElements: Int!
  totalPages: Int!
  size: Int!
  number: Int!
}

type AdminVoPage {
  content: [AdminVo!]!
  totalElements: Int!
  totalPages: Int!
  size: Int!
  number: Int!
}

type DeliveryWorkerVoPage {
  content: [DeliveryWorkerVo!]!
  totalElements: Int!
  totalPages: Int!
  size: Int!
  number: Int!
}
