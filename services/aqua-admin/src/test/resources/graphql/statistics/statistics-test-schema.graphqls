# Test Schema for Statistics Integration Tests
# 自包含 schema,仅被 @TestPropertySource(spring.graphql.schema.locations=classpath:graphql/statistics/) 加载
# 与 services/aqua-admin/src/main/resources/graphql/modules/statistics.graphqls + shared-types OrderStatisticsVO
# 保持一致(G42 接线 + G38 completedOrders + G37 状态分布/客单价分布/高峰时段分析)

scalar Long
scalar LocalDateTime

type Query {
  orderStatistics(input: DateRangeInput!): OrderStatisticsVO!
  dailyStatistics(input: DateRangeInput!): [DailyStatisticVO!]!
  weeklyStatistics(input: DateRangeInput!): [WeeklyStatisticVO!]!
  monthlyStatistics(input: DateRangeInput!): [MonthlyStatisticVO!]!
  pendingOrderBreakdown: PendingOrderBreakdownVO!
}

input DateRangeInput {
  startDate: LocalDateTime!
  endDate: LocalDateTime!
}

type DateRangeVO {
  startDate: LocalDateTime!
  endDate: LocalDateTime!
}

enum OrderStatus {
  PENDING_PAYMENT
  PENDING_DISPATCH
  PENDING_DELIVERY
  DELIVERING
  COMPLETED
  CANCELLED
  REFUNDED
}

type OrderStatisticsVO {
  totalOrders: Int!
  completedOrders: Int!
  totalRevenueCents: Long!
  averageOrderValueCents: Long!
  refundAmountCents: Long!
  netRevenueCents: Long!
  dateRange: DateRangeVO!
  statusDistribution: [OrderStatusStatisticVO!]!
  orderValueDistribution: [OrderValueBucketStatisticVO!]!
  peakHourDistribution: [PeakHourStatisticVO!]!
}

type OrderStatusStatisticVO {
  status: OrderStatus!
  count: Int!
}

type OrderValueBucketStatisticVO {
  fromCents: Long
  toCents: Long
  label: String!
  count: Int!
}

type PeakHourStatisticVO {
  hour: Int!
  count: Int!
}

type DailyStatisticVO {
  date: String!
  orderCount: Int!
  orderProductCount: Int!
  revenueCents: Long!
  refundCents: Long!
}

type WeeklyStatisticVO {
  weekNumber: Int!
  year: Int!
  startDate: String!
  endDate: String!
  orderCount: Int!
  orderProductCount: Int!
  revenueCents: Long!
  refundCents: Long!
}

type MonthlyStatisticVO {
  month: Int!
  year: Int!
  monthName: String!
  orderCount: Int!
  orderProductCount: Int!
  revenueCents: Long!
  refundCents: Long!
}

type PendingOrderBreakdownVO {
  pendingPayment: Int!
  pendingDispatch: Int!
  pendingDelivery: Int!
  total: Int!
}
