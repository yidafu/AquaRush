# Test Schema for Statistics Integration Tests
# 自包含 schema,仅被 @TestPropertySource(spring.graphql.schema.locations=classpath:graphql/statistics/) 加载
# 与 services/aqua-admin/src/main/resources/graphql/modules/statistics.graphqls + shared-types OrderStatistics
# 保持一致(G42 接线 + G38 completedOrders + G37 状态分布/客单价分布/高峰时段分析)

scalar Long
scalar LocalDateTime

type Query {
  orderStatistics(input: DateRangeInput!): OrderStatistics!
  dailyStatistics(input: DateRangeInput!): [DailyStatistic!]!
  weeklyStatistics(input: DateRangeInput!): [WeeklyStatistic!]!
  monthlyStatistics(input: DateRangeInput!): [MonthlyStatistic!]!
  pendingOrderBreakdown: PendingOrderBreakdown!
}

input DateRangeInput {
  startDate: LocalDateTime!
  endDate: LocalDateTime!
}

type DateRange {
  startDate: LocalDateTime!
  endDate: LocalDateTime!
}

enum OrderStatus {
  PENDING_PAYMENT
  PENDING_DISPATCH
  PENDING_DELIVERY
  DELIVERING
  COMPLETED
  CANCELLED
  REFUNDED
}

type OrderStatistics {
  totalOrders: Int!
  completedOrders: Int!
  totalRevenueCents: Long!
  averageOrderValueCents: Long!
  dateRange: DateRange!
  statusDistribution: [OrderStatusStatistic!]!
  orderValueDistribution: [OrderValueBucketStatistic!]!
  peakHourDistribution: [PeakHourStatistic!]!
}

type OrderStatusStatistic {
  status: OrderStatus!
  count: Int!
}

type OrderValueBucketStatistic {
  fromCents: Long
  toCents: Long
  label: String!
  count: Int!
}

type PeakHourStatistic {
  hour: Int!
  count: Int!
}

type DailyStatistic {
  date: String!
  orderCount: Int!
  orderProductCount: Int!
  revenueCents: Long!
}

type WeeklyStatistic {
  weekNumber: Int!
  year: Int!
  startDate: String!
  endDate: String!
  orderCount: Int!
  orderProductCount: Int!
  revenueCents: Long!
}

type MonthlyStatistic {
  month: Int!
  year: Int!
  monthName: String!
  orderCount: Int!
  orderProductCount: Int!
  revenueCents: Long!
}

type PendingOrderBreakdown {
  pendingPayment: Int!
  pendingDispatch: Int!
  pendingDelivery: Int!
  total: Int!
}
