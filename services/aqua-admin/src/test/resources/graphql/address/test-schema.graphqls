# Test Schema for AddressResolver GraphQL Integration Tests

scalar Long

type Query {
  searchAllAddresses(keyword: String, page: Int, size: Int): AddressVOPage!
  userAddresses(userId: Long): [AddressVO!]!
}

type AddressVOPage {
  content: [AddressVO!]!
  totalElements: Int!
  totalPages: Int!
  size: Int!
  number: Int!
}

type Mutation {
  createAdminAddress(input: AddressInput!): AddressVO!
  updateAdminAddress(id: Long!, input: UpdateAddressInput!): AddressVO!
  deleteAdminAddress(id: Long!): Boolean!
}

type AddressVO {
  id: Long!
  userId: Long!
  receiverName: String!
  phone: String!
  province: String!
  provinceCode: String
  city: String!
  cityCode: String
  district: String!
  districtCode: String
  detailAddress: String!
  isDefault: Boolean!
}

input AddressInput {
  receiverName: String!
  phone: String!
  province: String!
  provinceCode: String
  city: String!
  cityCode: String
  district: String!
  districtCode: String
  detailAddress: String!
  isDefault: Boolean
}

input UpdateAddressInput {
  receiverName: String
  phone: String
  province: String
  provinceCode: String
  city: String
  cityCode: String
  district: String
  districtCode: String
  detailAddress: String
  floor: Int
  longitude: Float
  latitude: Float
  isDefault: Boolean
}
