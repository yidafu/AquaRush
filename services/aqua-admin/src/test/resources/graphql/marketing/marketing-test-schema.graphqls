# Test Schema for AdminVo Marketing Resolvers GraphQL Integration Tests
# 自包含 schema(仿 ops 测试目录模式),仅被 @TestPropertySource(spring.graphql.schema.locations=classpath:graphql/marketing/) 加载
# 与 services/aqua-admin/src/main/resources/graphql/modules/marketing.graphqls 保持一致(F-MKT-001/002/003/004/007)

scalar Long
scalar LocalDateTime

type Query {
  customerGroups(input: CustomerGroupListInput): CustomerGroupVoPage
  customerGroup(id: Long!): CustomerGroupVo
  groupProductPrices(input: GroupProductPriceListInput!): GroupProductPriceVoPage
  couponTemplates(input: CouponTemplateListInput): CouponTemplateVoPage
  couponTemplate(id: Long!): CouponTemplateAdminVo
  promotionActivities(input: PromotionActivityListInput): PromotionActivityVoPage
  promotionActivity(id: Long!): PromotionActivityVo
  ticketTypes(input: TicketTypeListInput): TicketTypeVoPage
  ticketType(id: Long!): TicketTypeAdminVo
  flashSaleActivities(input: FlashSaleActivityListInput): FlashSaleActivityVoPage
  flashSaleActivity(id: Long!): FlashSaleActivityVo
  giftActivities(input: GiftActivityListInput): GiftActivityVoPage
  giftActivity(id: Long!): GiftActivityVo
  firstOrderActivities(input: FirstOrderActivityListInput): FirstOrderActivityVoPage
  firstOrderActivity(id: Long!): FirstOrderActivityVo
  # 用户持有券/票(用户详情页 Tab;F-USR-022)
  userCoupons(userId: Long!, status: UserCouponStatus): [UserCouponVo!]!
  userTickets(userId: Long!, status: UserTicketStatus): [UserTicketVo!]!
}

type Mutation {
  createCustomerGroup(input: CreateCustomerGroupInput!): CustomerGroupVo!
  updateCustomerGroup(id: Long!, input: UpdateCustomerGroupInput!): CustomerGroupVo!
  deleteCustomerGroup(id: Long!): Boolean!
  setUserCustomerGroup(userId: Long!, customerGroupId: Long): Boolean!
  saveGroupProductPrices(input: SaveGroupProductPricesInput!): Boolean!
  createCouponTemplate(input: CreateCouponTemplateInput!): CouponTemplateAdminVo!
  updateCouponTemplate(id: Long!, input: UpdateCouponTemplateInput!): CouponTemplateAdminVo!
  disableCouponTemplate(id: Long!): CouponTemplateAdminVo!
  issueCoupons(input: IssueCouponsInput!): Int!
  createPromotionActivity(input: CreatePromotionActivityInput!): PromotionActivityVo!
  updatePromotionActivity(id: Long!, input: UpdatePromotionActivityInput!): PromotionActivityVo!
  disablePromotionActivity(id: Long!): PromotionActivityVo!
  createTicketType(input: CreateTicketTypeInput!): TicketTypeAdminVo!
  updateTicketType(id: Long!, input: UpdateTicketTypeInput!): TicketTypeAdminVo!
  disableTicketType(id: Long!): TicketTypeAdminVo!
  createFlashSaleActivity(input: CreateFlashSaleActivityInput!): FlashSaleActivityVo!
  updateFlashSaleActivity(id: Long!, input: UpdateFlashSaleActivityInput!): FlashSaleActivityVo!
  disableFlashSaleActivity(id: Long!): FlashSaleActivityVo!
  createGiftActivity(input: CreateGiftActivityInput!): GiftActivityVo!
  updateGiftActivity(id: Long!, input: UpdateGiftActivityInput!): GiftActivityVo!
  disableGiftActivity(id: Long!): GiftActivityVo!
  createFirstOrderActivity(input: CreateFirstOrderActivityInput!): FirstOrderActivityVo!
  updateFirstOrderActivity(id: Long!, input: UpdateFirstOrderActivityInput!): FirstOrderActivityVo!
  disableFirstOrderActivity(id: Long!): FirstOrderActivityVo!
}

# ============ 客户分组(F-MKT-001) ============

type CustomerGroupVo {
  id: Long!
  name: String!
  description: String
  memberCount: Int!
  createdAt: LocalDateTime!
  updatedAt: LocalDateTime!
}

type CustomerGroupVoPage {
  content: [CustomerGroupVo!]!
  totalElements: Int!
  totalPages: Int!
  size: Int!
  number: Int!
}

input CustomerGroupListInput {
  keyword: String
  page: Int = 0
  size: Int = 20
}

input CreateCustomerGroupInput {
  name: String!
  description: String
  memberIds: [Long!]
}

input UpdateCustomerGroupInput {
  name: String!
  description: String
  memberIds: [Long!]
}

# ============ 分组商品专属价(F-MKT-002) ============

type GroupProductPriceVo {
  id: Long!
  customerGroupId: Long!
  productId: Long!
  productName: String
  productSpecification: String
  catalogPriceCents: Long!
  priceCents: Long
}

type GroupProductPriceVoPage {
  content: [GroupProductPriceVo!]!
  totalElements: Int!
  totalPages: Int!
  size: Int!
  number: Int!
}

input GroupProductPriceListInput {
  customerGroupId: Long!
  keyword: String
  page: Int = 0
  size: Int = 20
}

input GroupProductPriceItemInput {
  productId: Long!
  priceCents: Long
}

input SaveGroupProductPricesInput {
  customerGroupId: Long!
  items: [GroupProductPriceItemInput!]!
  clearUnlisted: Boolean = false
}

# ============ 优惠券(F-MKT-003) ============

type CouponTemplateAdminVo {
  id: Long!
  name: String!
  couponType: CouponType!
  thresholdCents: Long
  discountAmountCents: Long
  discountRatePermille: Long
  scope: CouponScope!
  productId: Long
  validityType: ValidityType!
  validFrom: LocalDateTime
  validTo: LocalDateTime
  validDays: Int
  issuanceType: CouponIssuanceType!
  perUserLimit: Int!
  status: CouponTemplateStatus!
  receivedCount: Int!
  usedCount: Int!
  createdAt: LocalDateTime!
  updatedAt: LocalDateTime!
}

type CouponTemplateVoPage {
  content: [CouponTemplateAdminVo!]!
  totalElements: Int!
  totalPages: Int!
  size: Int!
  number: Int!
}

enum CouponType {
  CASH
  DISCOUNT
  NO_THRESHOLD_CASH
}

enum CouponScope {
  ALL
  PRODUCT
}

# 用户持有券/票(用户详情页 Tab;与 shared-config UserCouponVo/UserTicketVo 保持一致)
type UserCouponVo {
  id: Long!
  name: String!
  couponType: CouponType!
  thresholdCents: Long
  discountAmountCents: Long
  discountRatePermille: Long
  scope: CouponScope!
  productId: Long
  status: UserCouponStatus!
  expireTime: LocalDateTime!
  usable: Boolean!
}

enum UserCouponStatus {
  RECEIVED
  USED
  RETURNED
  EXPIRED
}

type UserTicketVo {
  id: Long!
  ticketTypeName: String!
  specification: String
  status: UserTicketStatus!
  expireTime: LocalDateTime!
  isGift: Boolean!
  # G97 复购激活:true=待激活(复购条件未满足,不可核销)
  pendingActivation: Boolean!
  # G97 复购激活单数(空=非激活票)
  activationOrderCount: Int
}

enum UserTicketStatus {
  UNUSED
  USED
  RETURNED
  EXPIRED
}

enum ValidityType {
  FIXED_RANGE
  DAYS_AFTER_CLAIM
  DAYS_AFTER_PURCHASE
}

enum CouponIssuanceType {
  AUTO_CLAIM
  TARGETED
}

enum CouponTemplateStatus {
  ACTIVE
  DISABLED
}

input CouponTemplateListInput {
  keyword: String
  status: CouponTemplateStatus
  page: Int = 0
  size: Int = 20
}

input CreateCouponTemplateInput {
  name: String!
  couponType: CouponType!
  thresholdCents: Long
  discountAmountCents: Long
  discountRatePermille: Long
  scope: CouponScope!
  productId: Long
  validityType: ValidityType!
  validFrom: LocalDateTime
  validTo: LocalDateTime
  validDays: Int
  issuanceType: CouponIssuanceType!
  perUserLimit: Int!
}

input UpdateCouponTemplateInput {
  name: String!
  couponType: CouponType!
  thresholdCents: Long
  discountAmountCents: Long
  discountRatePermille: Long
  scope: CouponScope!
  productId: Long
  validityType: ValidityType!
  validFrom: LocalDateTime
  validTo: LocalDateTime
  validDays: Int
  perUserLimit: Int!
}

input IssueCouponsInput {
  couponTemplateId: Long!
  targetType: IssueTargetType!
  userIds: [Long!]
  customerGroupId: Long
}

enum IssueTargetType {
  USER
  GROUP
}

# ============ 满减/折扣活动(F-MKT-004) ============

type PromotionActivityVo {
  id: Long!
  name: String!
  activityType: PromotionActivityType!
  scope: PromotionScope!
  productId: Long
  customerGroupId: Long
  validFrom: LocalDateTime!
  validTo: LocalDateTime!
  status: PromotionActivityStatus!
  currentStatus: PromotionActivityDisplayStatus!
  tiers: [PromotionActivityTierVo!]!
  createdAt: LocalDateTime!
  updatedAt: LocalDateTime!
}

type PromotionActivityTierVo {
  id: Long!
  thresholdCents: Long!
  discountAmountCents: Long
  discountRatePermille: Long
}

type PromotionActivityVoPage {
  content: [PromotionActivityVo!]!
  totalElements: Int!
  totalPages: Int!
  size: Int!
  number: Int!
}

enum PromotionActivityType {
  FULL_REDUCE
  FULL_DISCOUNT
}

enum PromotionScope {
  ALL
  PRODUCT
  GROUP
}

enum PromotionActivityStatus {
  ACTIVE
  DISABLED
}

enum PromotionActivityDisplayStatus {
  UPCOMING
  ONGOING
  ENDED
  DISABLED
}

input PromotionActivityListInput {
  keyword: String
  page: Int = 0
  size: Int = 20
}

input PromotionTierInput {
  thresholdCents: Long!
  discountAmountCents: Long
  discountRatePermille: Long
}

input CreatePromotionActivityInput {
  name: String!
  activityType: PromotionActivityType!
  scope: PromotionScope!
  productId: Long
  customerGroupId: Long
  validFrom: LocalDateTime!
  validTo: LocalDateTime!
  tiers: [PromotionTierInput!]!
}

input UpdatePromotionActivityInput {
  name: String!
  activityType: PromotionActivityType!
  scope: PromotionScope!
  productId: Long
  customerGroupId: Long
  validFrom: LocalDateTime!
  validTo: LocalDateTime!
  tiers: [PromotionTierInput!]!
}

# ============ 桶水票(F-MKT-007) ============

type TicketTypeAdminVo {
  id: Long!
  name: String!
  ticketType: TicketTypeKind!
  productId: Long
  specification: String
  packageCount: Int!
  packagePriceCents: Long!
  giftCount: Int!
  validityType: ValidityType!
  validFrom: LocalDateTime
  validTo: LocalDateTime
  validDays: Int
  perUserLimit: Int!
  status: TicketTypeStatus!
  # G97 运营策略(R-MKT-08 修订)
  isLeadGeneration: Boolean!
  activationOrderCount: Int
  maxRedeemPerOrder: Int
  createdAt: LocalDateTime!
  updatedAt: LocalDateTime!
}

type TicketTypeVoPage {
  content: [TicketTypeAdminVo!]!
  totalElements: Int!
  totalPages: Int!
  size: Int!
  number: Int!
}

enum TicketTypeKind {
  SPECIFIC_PRODUCT
  UNIVERSAL
}

enum TicketTypeStatus {
  ACTIVE
  DISABLED
}

input TicketTypeListInput {
  keyword: String
  status: TicketTypeStatus
  page: Int = 0
  size: Int = 20
}

input CreateTicketTypeInput {
  name: String!
  ticketType: TicketTypeKind!
  productId: Long
  specification: String
  packageCount: Int!
  packagePriceCents: Long!
  giftCount: Int!
  validityType: ValidityType!
  validFrom: LocalDateTime
  validTo: LocalDateTime
  validDays: Int
  perUserLimit: Int!
  # G97 运营策略(R-MKT-08 修订)
  isLeadGeneration: Boolean
  activationOrderCount: Int
  maxRedeemPerOrder: Int
}

input UpdateTicketTypeInput {
  name: String!
  ticketType: TicketTypeKind!
  productId: Long
  specification: String
  packageCount: Int!
  packagePriceCents: Long!
  giftCount: Int!
  validityType: ValidityType!
  validFrom: LocalDateTime
  validTo: LocalDateTime
  validDays: Int
  perUserLimit: Int!
  # G97 运营策略(R-MKT-08 修订)
  isLeadGeneration: Boolean
  activationOrderCount: Int
  maxRedeemPerOrder: Int
}

# ============ 限时特价活动(F-MKT-005) ============

type FlashSaleActivityVo {
  id: Long!
