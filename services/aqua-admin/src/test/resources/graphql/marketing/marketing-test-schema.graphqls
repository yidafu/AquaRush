input CreateGiftActivityInput {
  name: String!
  giftType: GiftActivityType!
  thresholdCents: Long
  thresholdQuantity: Int
  scope: PromotionScope!
  productId: Long
  customerGroupId: Long
  giftProductId: Long!
  giftQuantity: Int!
  validFrom: LocalDateTime!
  validTo: LocalDateTime!
}

