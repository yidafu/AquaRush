  newcomerPriceCents: Long
  validFrom: LocalDateTime!
  validTo: LocalDateTime!
  status: PromotionActivityStatus!
  currentStatus: PromotionActivityDisplayStatus!
  createdAt: LocalDateTime!
  updatedAt: LocalDateTime!
}

type FirstOrderActivityVOPage {
  content: [FirstOrderActivity!]!
  totalElements: Int!
  totalPages: Int!
  size: Int!
  number: Int!
}

input FirstOrderActivityListInput {
  keyword: String
  page: Int = 0
  size: Int = 20
