input CreateFirstOrderActivityInput {
  name: String!
  activityType: FirstOrderActivityType!
  thresholdCents: Long
  discountAmountCents: Long
  discountRatePermille: Long
  scope: PromotionScope!
  productId: Long
  newcomerPriceCents: Long
