# Test Schema for AdminVo System Config Resolvers GraphQL Integration Tests
# 自包含 schema(仿 ops 测试目录模式),仅被 @TestPropertySource(spring.graphql.schema.locations=classpath:graphql/system/) 加载
# 含 productStatistics 声明,供库存阈值消费断言(AC-SYS-003)在同一测试切片内执行

scalar Long
scalar LocalDateTime

type Query {
  systemConfigs(group: SystemConfigGroup!): [SystemConfigVo!]!
  productStatistics: ProductStatisticsVo
}

type Mutation {
  saveSystemConfigs(input: [SaveSystemConfigInput!]!): [SystemConfigVo!]!
  restoreSystemConfig(settingKey: String!): SystemConfigVo!
}

enum SystemConfigGroup {
  ORDER_AND_FULFILLMENT
  INVENTORY
  SECURITY
  NOTIFICATION
  DATA_MAINTENANCE
}

enum SystemSettingType {
  NUMBER
  BOOLEAN
  STRING
  ENUM
}

type SystemConfigVo {
  id: Long!
  settingKey: String!
  settingType: SystemSettingType!
  settingGroup: SystemConfigGroup!
  settingValue: String
  defaultValue: String
  description: String
  minValue: String
  maxValue: String
  options: String
  updatedBy: String
  updatedAt: LocalDateTime!
}

input SaveSystemConfigInput {
  settingKey: String!
  settingValue: String
}

type ProductStatisticsVo {
  lowStockProducts: Int!
}
