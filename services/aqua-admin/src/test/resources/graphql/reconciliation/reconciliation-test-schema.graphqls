# Reconciliation integration test schema
# Only exposes what AdminDailyCollectionGraphQLIntegrationTest exercises.

scalar Long
scalar LocalDateTime
scalar JsonObject
scalar PrimaryId

enum OrderStatus {
  PENDING_PAYMENT
  PENDING_DISPATCH
  PENDING_DELIVERY
  DELIVERING
  AWAITING_CONFIRMATION
  COMPLETED
  CANCELLED
  REFUNDED
}

enum PaymentType {
  WATER_TICKET
  CASH
  QR_CODE
}

type Query {
  _dummy: String
  dailyCollections(input: DailyCollectionListInput): DailyCollectionPage!
  dailyReconciliations(input: DailyReconciliationListInput): DailyReconciliationPage!
  dailyCollectionSummary(collectionDate: String): DailyCollectionSummary!
  dailyReconciliationOrderDetails(
    reconciliationDate: String!
    deliveryWorkerId: Long
    page: Int = 0
    size: Int = 20
  ): ReconciliationOrderDetailPage!
}

type Mutation {
  rejectDailyCollection(input: RejectDailyCollectionInput!): DailyCollectionRecord!
}

input RejectDailyCollectionInput {
  recordId: PrimaryId!
  reason: String!
}

input DailyCollectionListInput {
  collectionDate: String
  deliveryWorkerId: Long
  page: Int = 0
  size: Int = 10
}

input DailyReconciliationListInput {
  page: Int = 0
  size: Int = 10
}

type DailyCollectionPage {
  list: [DailyCollectionRecord!]!
  pageInfo: PageInfo!
}

type DailyReconciliationPage {
  list: [DailyReconciliation!]!
  pageInfo: PageInfo!
}

type DailyCollectionSummary {
  collectionDate: String!
  totalCashAmountCents: Long!
  totalQrCodeAmountCents: Long!
  totalWaterTicketCount: Int!
  totalOrderCount: Int!
  totalOrderAmountCents: Long!
  totalSubmittedCount: Int!
}

type ReconciliationOrderDetail {
  orderId: PrimaryId!
  orderNo: String!
  deliveryWorkerId: PrimaryId
  amountCents: Long!
  paymentType: PaymentType
  status: OrderStatus!
  deliveredAt: LocalDateTime
}

type ReconciliationOrderDetailPage {
  list: [ReconciliationOrderDetail!]!
  pageInfo: PageInfo!
}

type PageInfo {
  total: Int!
  pageSize: Int!
  pageNum: Int!
  hasNext: Boolean!
  hasPrevious: Boolean!
  totalPages: Int!
}

type DailyCollectionRecord {
  id: PrimaryId!
  deliveryWorkerId: PrimaryId!
  collectionDate: String!
  cashAmountCents: Long!
  waterTicketCount: Int!
  qrCodeAmountCents: Long!
  orderCount: Int!
  orderAmountCents: Long!
  differenceAmountCents: Long!
  status: String!
  rejectedAt: LocalDateTime
  rejectedBy: PrimaryId
  rejectReason: String
  createdAt: LocalDateTime!
  updatedAt: LocalDateTime!
}

type DailyReconciliation {
  id: PrimaryId!
  reconciliationDate: String!
  totalCashAmountCents: Long!
  totalWaterTicketCount: Int!
  totalQrCodeAmountCents: Long!
  totalOrderCount: Int!
  totalOrderAmountCents: Long!
  totalCollectionAmountCents: Long!
  discrepancyAmountCents: Long!
  status: String!
  reportData: JsonObject
  reviewedAt: LocalDateTime
  reviewedBy: PrimaryId
  reviewNotes: String
  createdAt: LocalDateTime!
  updatedAt: LocalDateTime!
}
