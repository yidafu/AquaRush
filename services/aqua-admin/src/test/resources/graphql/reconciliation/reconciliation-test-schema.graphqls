# Reconciliation integration test schema
# Only exposes what AdminDailyCollectionGraphQLIntegrationTest exercises.

scalar Long
scalar LocalDateTime
scalar JsonObject
scalar PrimaryId

enum OrderStatus {
  PENDING_PAYMENT
  PENDING_DISPATCH
  PENDING_DELIVERY
  DELIVERING
  AWAITING_CONFIRMATION
  COMPLETED
  CANCELLED
  REFUNDED
}

enum PaymentType {
  WATER_TICKET
  CASH
  QR_CODE
}

type Query {
  _dummy: String
  dailyCollections(input: DailyCollectionListInput): DailyCollectionVoPage!
  dailyReconciliations(input: DailyReconciliationListInput): DailyReconciliationVoPage!
  dailyCollectionSummary(collectionDate: String): DailyCollectionSummaryVo!
  dailyReconciliationOrderDetails(
    reconciliationDate: String!
    deliveryWorkerId: Long
    page: Int = 0
    size: Int = 20
  ): ReconciliationOrderDetailVoPage!
}

type Mutation {
  rejectDailyCollection(input: RejectDailyCollectionInput!): DailyCollectionRecordVo!
}

input RejectDailyCollectionInput {
  recordId: PrimaryId!
  reason: String!
}

input DailyCollectionListInput {
  collectionDate: String
  deliveryWorkerId: Long
  page: Int = 0
  size: Int = 10
}

input DailyReconciliationListInput {
  page: Int = 0
  size: Int = 10
}

type DailyCollectionVoPage {
  list: [DailyCollectionRecordVo!]!
  pageInfo: PageInfoVo!
}

type DailyReconciliationVoPage {
  list: [DailyReconciliationVo!]!
  pageInfo: PageInfoVo!
}

type DailyCollectionSummaryVo {
  collectionDate: String!
  totalCashAmountCents: Long!
  totalQrCodeAmountCents: Long!
  totalWaterTicketCount: Int!
  totalOrderCount: Int!
  totalOrderAmountCents: Long!
  totalSubmittedCount: Int!
}

type ReconciliationOrderDetailVo {
  orderId: PrimaryId!
  orderNo: String!
  deliveryWorkerId: PrimaryId
  amountCents: Long!
  paymentType: PaymentType
  status: OrderStatus!
  deliveredAt: LocalDateTime
}

type ReconciliationOrderDetailVoPage {
  list: [ReconciliationOrderDetailVo!]!
  pageInfo: PageInfoVo!
}

type PageInfoVo {
  total: Int!
  pageSize: Int!
  pageNum: Int!
  hasNext: Boolean!
  hasPrevious: Boolean!
  totalPages: Int!
}

type DailyCollectionRecordVo {
  id: PrimaryId!
  deliveryWorkerId: PrimaryId!
  collectionDate: String!
  cashAmountCents: Long!
  waterTicketCount: Int!
  qrCodeAmountCents: Long!
  orderCount: Int!
  orderAmountCents: Long!
  differenceAmountCents: Long!
  status: String!
  rejectedAt: LocalDateTime
  rejectedBy: PrimaryId
  rejectReason: String
  createdAt: LocalDateTime!
  updatedAt: LocalDateTime!
}

type DailyReconciliationVo {
  id: PrimaryId!
  reconciliationDate: String!
  totalCashAmountCents: Long!
  totalWaterTicketCount: Int!
  totalQrCodeAmountCents: Long!
  totalOrderCount: Int!
  totalOrderAmountCents: Long!
  totalCollectionAmountCents: Long!
  discrepancyAmountCents: Long!
  status: String!
  reportData: JsonObject
  reviewedAt: LocalDateTime
  reviewedBy: PrimaryId
  reviewNotes: String
  createdAt: LocalDateTime!
  updatedAt: LocalDateTime!
}

# ==================== 微信资金对账域(测试子集) ====================
# 仅暴露 AdminWechatReconciliationGraphQLIntegrationTest 覆盖的字段

enum ReconciliationTaskType {
  PAYMENT
  REFUND
  SETTLEMENT
}

enum ReconciliationTaskStatus {
  PENDING
  RUNNING
  SUCCESS
  FAILED
}

enum DiscrepancyType {
  MISSING
  MISMATCH
  EXTRA
}

enum DiscrepancyStatus {
  UNRESOLVED
  RESOLVED
}

enum SourceSystem {
  INTERNAL
  WECHAT
}

type ReconciliationTaskVo {
  id: PrimaryId!
  taskId: String!
  taskType: ReconciliationTaskType!
  status: ReconciliationTaskStatus!
  taskDate: LocalDateTime!
  startTime: LocalDateTime
  endTime: LocalDateTime
  totalRecords: Int!
  matchedRecords: Int!
  unmatchedRecords: Int!
  errorMessage: String
  createdAt: LocalDateTime!
  updatedAt: LocalDateTime!
}

type ReconciliationTaskVoPage {
  content: [ReconciliationTaskVo!]!
  totalElements: Int!
  totalPages: Int!
  size: Int!
  number: Int!
}

type ReconciliationDiscrepancyVo {
  id: PrimaryId!
  taskId: String!
  discrepancyType: DiscrepancyType!
  sourceSystem: SourceSystem!
  recordId: String!
  recordDetails: JsonObject
  status: DiscrepancyStatus!
  resolutionNotes: String
  resolvedBy: String
  resolvedAt: LocalDateTime
  createdAt: LocalDateTime!
  updatedAt: LocalDateTime!
}

type ReconciliationDiscrepancyVoPage {
  content: [ReconciliationDiscrepancyVo!]!
  totalElements: Int!
  totalPages: Int!
  size: Int!
  number: Int!
}

type ReconciliationReportVo {
  id: PrimaryId!
  taskId: String!
  reportType: String!
  reportData: JsonObject!
  fileName: String
  filePath: String
  fileSize: Long
  generatedAt: LocalDateTime!
}

input ExecuteReconciliationInput {
  taskType: ReconciliationTaskType!
  reconciliationDate: String!
}

input ResolveDiscrepancyInput {
  discrepancyId: PrimaryId!
  resolutionNotes: String!
}

extend type Query {
  # 微信资金对账查询
  reconciliationTasks(
    taskType: ReconciliationTaskType
    status: ReconciliationTaskStatus
    dateFrom: String
    dateTo: String
    page: Int = 0
    size: Int = 20
  ): ReconciliationTaskVoPage!
  reconciliationTask(taskId: String!): ReconciliationTaskVo
  reconciliationDiscrepancies(
    taskId: String
    status: DiscrepancyStatus
    page: Int = 0
    size: Int = 20
  ): ReconciliationDiscrepancyVoPage!
  reconciliationReports(taskId: String!, reportType: String): [ReconciliationReportVo!]!
}

extend type Mutation {
  # 微信资金对账变更
  executeReconciliation(input: ExecuteReconciliationInput!): ReconciliationTaskVo!
  resolveDiscrepancy(input: ResolveDiscrepancyInput!): Boolean!
}
