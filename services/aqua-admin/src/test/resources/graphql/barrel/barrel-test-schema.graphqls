# Test Schema for Admin Deposit Resolvers GraphQL Integration Tests
# 自包含 schema,仅被 @TestPropertySource(spring.graphql.schema.locations=classpath:graphql/barrel/) 加载
# 与 services/aqua-admin/src/main/resources/graphql/modules/barrel.graphqls + shared-types 保持一致
# (B2 押金模型回退 R-MON-03/F-PRO-012;本快照仅覆盖价目与记录/申请列表用例)

scalar Long
scalar LocalDateTime

# 押金价目状态
enum DepositPriceStatus {
  ENABLED
  DISABLED
}

# 押金记录状态(R-MON-03)
enum DepositStatus {
  PENDING
  HELD
  REFUNDED
}

# 退押申请状态机(R-PRO-04)
enum DepositRefundApplicationStatus {
  PENDING
  RECOVERED
  REFUNDED
  REJECTED
}

type DepositPriceVo {
  id: Long!
  specification: String!
  depositCents: Long!
  status: DepositPriceStatus!
  sortOrder: Int!
  createdAt: LocalDateTime!
  updatedAt: LocalDateTime!
}

type DepositPriceVoPage {
  content: [DepositPriceVo!]!
  totalElements: Int!
  totalPages: Int!
  size: Int!
  number: Int!
}

type DepositRecordVo {
  id: Long!
  orderId: Long!
  specification: String
  unitDepositCents: Long
  bucketCount: Int
  depositAmountCents: Long!
  status: DepositStatus!
  collectedAt: LocalDateTime
  refundedAt: LocalDateTime
  refundRemark: String
  createdAt: LocalDateTime!
}

type DepositRecordVoPage {
  content: [DepositRecordVo!]!
  totalElements: Int!
  totalPages: Int!
  size: Int!
  number: Int!
}

type DepositRefundApplicationVo {
  id: Long!
  specification: String!
  bucketCount: Int!
  depositCents: Long!
  receiverName: String
  receiverPhone: String
  receiverDetail: String
  remark: String
  status: DepositRefundApplicationStatus!
  rejectReason: String
  recoveredAt: LocalDateTime
  refundedAt: LocalDateTime
  rejectedAt: LocalDateTime
  createdAt: LocalDateTime!
}

type DepositRefundApplicationVoPage {
  content: [DepositRefundApplicationVo!]!
  totalElements: Int!
  totalPages: Int!
  size: Int!
  number: Int!
}

input DepositPriceListInput {
  status: DepositPriceStatus
  keyword: String
  page: Int
  size: Int
}

input UpsertDepositPriceInput {
  id: Long
  specification: String!
  depositCents: Long!
  status: DepositPriceStatus
  sortOrder: Int
}

input DepositRecordListInput {
  userId: Long
  status: DepositStatus
  specification: String
  page: Int
  size: Int
}

type Query {
  depositPrices(input: DepositPriceListInput): DepositPriceVoPage!
  depositRecords(input: DepositRecordListInput): DepositRecordVoPage!
  depositRefundApplications(status: DepositRefundApplicationStatus, page: Int, size: Int): DepositRefundApplicationVoPage!
}

type Mutation {
  upsertDepositPrice(input: UpsertDepositPriceInput!): DepositPriceVo!
}
