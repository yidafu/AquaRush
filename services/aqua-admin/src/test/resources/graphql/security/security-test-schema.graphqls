# Security integration test schema
# Only exposes what AdminSecurityIntegrationTest exercises.

scalar Long

type Query {
  _dummy: String
}

type Mutation {
  createAdmin(input: CreateAdminInput!): Admin!
}

type Admin {
  id: Long!
  username: String!
  realName: String
  phone: String
  role: String!
}

input CreateAdminInput {
  username: String!
  realName: String
  phone: String
  password: String
  role: String!
}
