# Test Schema for AdminDeliveryWorkerResolver GraphQL Integration Tests

scalar Long

type Query {
  deliveryWorkers(keyword: String, role: String, page: Int = 0, size: Int = 20): DeliveryWorkerVOPage!
  onlineDeliveryWorkers: [DeliveryWorkerVO!]!
  deliveryWorker(id: Long!): DeliveryWorkerVO
}

type DeliveryWorkerVO {
  id: Long!
  userId: Long!
  wechatOpenId: String!
  name: String!
  phone: String!
  avatarUrl: String
  onlineStatus: DeliveryWorkerStatus!
  currentTaskCount: Int!
  earningCents: Long
  isAvailable: Boolean!
  totalOrders: Int!
  completedOrders: Int!
}

enum DeliveryWorkerStatus {
  ONLINE
  OFFLINE
}

type DeliveryWorkerVOPage {
  content: [DeliveryWorkerVO!]!
  totalElements: Int!
  totalPages: Int!
  size: Int!
  number: Int!
}
