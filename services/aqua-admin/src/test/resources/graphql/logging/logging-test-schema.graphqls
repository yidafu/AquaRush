# Test Schema for AdminVO BusinessLogVO Resolver GraphQL Integration Tests
# 自包含 schema(仿 ops/delivery-worker 测试目录模式),仅被 @TestPropertySource(spring.graphql.schema.locations=classpath:graphql/logging/) 加载

scalar Long
scalar LocalDateTime

type Query {
  businessLogs(input: BusinessLogListInput): BusinessLogVOPage
}

enum BizLogDomain {
  ORDER
  PAYMENT
  DELIVERY
  USER
  AUTH
}

enum BizLogLevel {
  TRACE
  DEBUG
  INFO
  WARN
  ERROR
}

type BusinessLogVO {
  id: Long!
  correlationId: String
  level: BizLogLevel!
  loggerName: String
  operation: String
  message: String
  stackTrace: String
  userId: Long
  username: String
  createdAt: LocalDateTime!
}

input BusinessLogListInput {
  domain: BizLogDomain
  operationType: String
  level: BizLogLevel
  userId: Long
  startTime: LocalDateTime
  endTime: LocalDateTime
  page: Int = 0
  size: Int = 10
}

type PageInfoVO {
  total: Int!
  pageSize: Int!
  pageNum: Int!
  hasNext: Boolean!
  hasPrevious: Boolean!
  totalPages: Int!
}

type BusinessLogVOPage {
  list: [BusinessLogVO!]!
  pageInfo: PageInfoVO!
}
