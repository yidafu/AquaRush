<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
  xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
    http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.33.xsd">

  <!--
    订单水票抵扣金额快照列(PRD 10-marketing.md §R-MKT-08):
    被核销桶按单价 0 计入应付,抵扣金额=商品小计-现金小计,下单时随单快照;
    供订单详情/列表/送水工端费用明细「水票抵扣(N桶)-¥x」展示。
    既有 ticket_redeem_count > 0 订单做 best-effort 回填:
    抵扣额 = Σ(order_items.unit_price_cents×quantity) − total_amount_cents
            − promotion_discount_cents − first_order_discount_cents − coupon_discount_cents
    (优惠封顶场景下回填值可能偏小,新建订单以快照列为准)。
  -->
  <changeSet id="1.9.0-add-order-ticket-discount-snapshot" author="aqua-rush">
    <preConditions onFail="CONTINUE" onErrorMessage="orders.ticket_discount_cents 已存在,跳过">
      <not>
        <columnExists tableName="orders" columnName="ticket_discount_cents"/>
      </not>
    </preConditions>
    <comment>Add ticket_discount_cents snapshot column to orders (R-MKT-08)</comment>
    <addColumn tableName="orders">
      <column name="ticket_discount_cents" type="bigint" defaultValueNumeric="0">
        <constraints nullable="false"/>
      </column>
    </addColumn>
  </changeSet>

  <changeSet id="1.9.0-backfill-order-ticket-discount" author="aqua-rush">
    <preConditions onFail="CONTINUE" onErrorMessage="orders.ticket_discount_cents 不存在,跳过回填">
      <columnExists tableName="orders" columnName="ticket_discount_cents"/>
    </preConditions>
    <comment>Backfill ticket_discount_cents for existing ticket orders (best-effort)</comment>
    <sql>
      UPDATE orders o
      SET ticket_discount_cents = GREATEST(0,
        (SELECT COALESCE(SUM(oi.unit_price_cents * oi.quantity), 0)
           FROM order_items oi
          WHERE oi.order_id = o.id AND oi.is_deleted = FALSE)
        - o.total_amount_cents
        - o.promotion_discount_cents
        - o.first_order_discount_cents
        - o.coupon_discount_cents)
      WHERE o.ticket_redeem_count > 0
        AND o.is_deleted = FALSE
    </sql>
  </changeSet>
</databaseChangeLog>
