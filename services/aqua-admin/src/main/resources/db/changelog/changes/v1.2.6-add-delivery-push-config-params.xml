<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.33.xsd">

  <changeSet id="1.2.6-add-delivery-push-config-params" author="aqua-rush">
    <comment>Seed delivery app real-time push config params for F-NTF-003 (scenario switches + offline polling interval)</comment>

    <!-- ==================== 送水 App 实时推送配置(F-NTF-003,NOTIFICATION 参数组) ==================== -->
    <insert tableName="system_settings">
      <column name="id">33</column>
      <column name="setting_key">delivery_push_new_order_enabled</column>
      <column name="setting_value">true</column>
      <column name="description">新订单(可抢单)推送,送水工在线时实时触达</column>
      <column name="setting_type">BOOLEAN</column>
      <column name="setting_group">NOTIFICATION</column>
      <column name="default_value">true</column>
      <column name="created_at">NOW()</column>
      <column name="updated_at">NOW()</column>
    </insert>
    <insert tableName="system_settings">
      <column name="id">34</column>
      <column name="setting_key">delivery_push_assigned_enabled</column>
      <column name="setting_value">true</column>
      <column name="description">被派单推送,订单派给送水工时实时触达</column>
      <column name="setting_type">BOOLEAN</column>
      <column name="setting_group">NOTIFICATION</column>
      <column name="default_value">true</column>
      <column name="created_at">NOW()</column>
      <column name="updated_at">NOW()</column>
    </insert>
    <insert tableName="system_settings">
      <column name="id">35</column>
      <column name="setting_key">delivery_push_cancelled_enabled</column>
      <column name="setting_value">true</column>
      <column name="description">订单取消推送,已接订单被取消时触达</column>
      <column name="setting_type">BOOLEAN</column>
      <column name="setting_group">NOTIFICATION</column>
      <column name="default_value">true</column>
      <column name="created_at">NOW()</column>
      <column name="updated_at">NOW()</column>
    </insert>
    <insert tableName="system_settings">
      <column name="id">36</column>
      <column name="setting_key">delivery_push_urging_enabled</column>
      <column name="setting_value">true</column>
      <column name="description">用户催单推送,用户催单时触达</column>
      <column name="setting_type">BOOLEAN</column>
      <column name="setting_group">NOTIFICATION</column>
      <column name="default_value">true</column>
      <column name="created_at">NOW()</column>
      <column name="updated_at">NOW()</column>
    </insert>
    <insert tableName="system_settings">
      <column name="id">37</column>
      <column name="setting_key">delivery_push_timeout_enabled</column>
      <column name="setting_value">true</column>
      <column name="description">配送超时推送,超时未配送时触达</column>
      <column name="setting_type">BOOLEAN</column>
      <column name="setting_group">NOTIFICATION</column>
      <column name="default_value">true</column>
      <column name="created_at">NOW()</column>
      <column name="updated_at">NOW()</column>
    </insert>
    <insert tableName="system_settings">
      <column name="id">38</column>
      <column name="setting_key">delivery_push_payment_timeout_enabled</column>
      <column name="setting_value">true</column>
      <column name="description">支付超时推送,待支付订单超时未支付时触达</column>
      <column name="setting_type">BOOLEAN</column>
      <column name="setting_group">NOTIFICATION</column>
      <column name="default_value">true</column>
      <column name="created_at">NOW()</column>
      <column name="updated_at">NOW()</column>
    </insert>
    <insert tableName="system_settings">
      <column name="id">39</column>
      <column name="setting_key">delivery_poll_interval_seconds</column>
      <column name="setting_value">30</column>
      <column name="description">离线/弱网轮询间隔(秒),实时通道断开时降级轮询(R-NTF-03,默认 30)</column>
      <column name="setting_type">NUMBER</column>
      <column name="setting_group">NOTIFICATION</column>
      <column name="default_value">30</column>
      <column name="min_value">5</column>
      <column name="max_value">300</column>
      <column name="created_at">NOW()</column>
      <column name="updated_at">NOW()</column>
    </insert>

  </changeSet>

</databaseChangeLog>
