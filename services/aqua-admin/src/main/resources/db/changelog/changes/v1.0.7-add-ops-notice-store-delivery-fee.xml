<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.33.xsd">

  <changeSet id="1.0.7-add-ops-notice-store-delivery-fee" author="aqua-rush">
    <comment>Add ops config tables (notices, store_profiles, delivery_fee_rules) and delivery fee snapshot for F-OPS-002/F-OPS-004/F-OPS-005</comment>

    <!-- 公告表(F-OPS-002) -->
    <createTable tableName="notices">
      <column name="id" type="bigint">
        <constraints primaryKey="true" nullable="false"/>
      </column>
      <column name="title" type="varchar(50)">
        <constraints nullable="false"/>
      </column>
      <column name="content" type="text">
        <constraints nullable="false"/>
      </column>
      <column name="type" type="varchar(30)">
        <constraints nullable="false"/>
      </column>
      <column name="pinned" type="boolean" defaultValueBoolean="false">
        <constraints nullable="false"/>
      </column>
      <column name="start_at" type="timestamp"/>
      <column name="end_at" type="timestamp"/>
      <column name="status" type="varchar(30)">
        <constraints nullable="false"/>
      </column>
      <column name="published_at" type="timestamp"/>
      <column name="created_at" type="timestamp">
        <constraints nullable="false"/>
      </column>
      <column name="updated_at" type="timestamp">
        <constraints nullable="false"/>
      </column>
      <column name="deleted_at" type="timestamp"/>
      <column name="deleted_by" type="bigint"/>
      <column name="is_deleted" type="boolean" defaultValue="false">
        <constraints nullable="false"/>
      </column>
    </createTable>

    <createIndex tableName="notices" indexName="idx_notices_pinned_published_at">
      <column name="pinned"/>
      <column name="published_at"/>
    </createIndex>

    <!-- 店铺信息配置表(F-OPS-004,单行配置 id=1) -->
    <createTable tableName="store_profiles">
      <column name="id" type="bigint">
        <constraints primaryKey="true" nullable="false"/>
      </column>
      <column name="shop_name" type="varchar(20)">
        <constraints nullable="false"/>
      </column>
      <column name="logo_url" type="varchar(1000)"/>
      <column name="service_hotline" type="varchar(30)">
        <constraints nullable="false"/>
      </column>
      <column name="business_hours_start" type="time"/>
      <column name="business_hours_end" type="time"/>
      <column name="shop_intro" type="varchar(100)"/>
      <column name="about_us" type="text"/>
      <column name="created_at" type="timestamp">
        <constraints nullable="false"/>
      </column>
      <column name="updated_at" type="timestamp">
        <constraints nullable="false"/>
      </column>
      <column name="deleted_at" type="timestamp"/>
      <column name="deleted_by" type="bigint"/>
      <column name="is_deleted" type="boolean" defaultValue="false">
        <constraints nullable="false"/>
      </column>
    </createTable>

    <!-- 配送费规则配置表(F-OPS-005,单行配置 id=1;楼层口径 R-MON-02) -->
    <createTable tableName="delivery_fee_rules">
      <column name="id" type="bigint">
        <constraints primaryKey="true" nullable="false"/>
      </column>
      <column name="free_floor_limit" type="int" defaultValueNumeric="4">
        <constraints nullable="false"/>
      </column>
      <column name="surcharge_cents" type="bigint" defaultValueNumeric="200">
        <constraints nullable="false"/>
      </column>
      <column name="created_at" type="timestamp">
        <constraints nullable="false"/>
      </column>
      <column name="updated_at" type="timestamp">
        <constraints nullable="false"/>
      </column>
      <column name="deleted_at" type="timestamp"/>
      <column name="deleted_by" type="bigint"/>
      <column name="is_deleted" type="boolean" defaultValue="false">
        <constraints nullable="false"/>
      </column>
    </createTable>

    <!-- 订单配送费快照列(下单时按配送费规则计算,已生成订单不受规则变更影响 —— R-MON-02) -->
    <addColumn tableName="orders">
      <column name="delivery_fee_cents" type="bigint" defaultValue="0">
        <constraints nullable="false"/>
      </column>
    </addColumn>

    <!-- 地址楼层列(配送费楼层判定用,空=无楼层信息/平房) -->
    <addColumn tableName="addresses">
      <column name="floor" type="int"/>
    </addColumn>

  </changeSet>

</databaseChangeLog>
