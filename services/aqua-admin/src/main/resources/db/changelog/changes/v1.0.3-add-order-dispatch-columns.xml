<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
    http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.33.xsd">

    <changeSet id="1.0.3-add-order-dispatch-columns" author="aqua-rush">
        <comment>Add dispatch-related columns to orders table for delivery assignment feature</comment>

        <!-- 是否自收（水钱已收/水票已扣） -->
        <addColumn tableName="orders">
            <column name="is_self_collect" type="boolean" defaultValueBoolean="false">
                <constraints nullable="false" />
            </column>
        </addColumn>

        <!-- 收款方式: WATER_TICKET(水票), CASH(现金), QR_CODE(扫码) -->
        <addColumn tableName="orders">
            <column name="payment_type" type="varchar(20)" />
        </addColumn>

        <!-- 开始配送时间 -->
        <addColumn tableName="orders">
            <column name="delivery_started_at" type="timestamp" />
        </addColumn>

        <!-- 配送确认时间 -->
        <addColumn tableName="orders">
            <column name="delivery_confirmed_at" type="timestamp" />
        </addColumn>

        <!-- 添加索引用于查询 -->
        <createIndex tableName="orders" indexName="idx_orders_delivery_worker_id">
            <column name="delivery_worker_id" />
        </createIndex>

        <createIndex tableName="orders" indexName="idx_orders_is_self_collect">
            <column name="is_self_collect" />
        </createIndex>
    </changeSet>

</databaseChangeLog>
