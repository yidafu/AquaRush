<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
  xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
    http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.33.xsd">

  <!--
    后台账号状态列(PRD/07-user.md §F-USR-020/021):
    admins.account_status ACTIVE/DISABLED,停用账号不可登录/不可派单接单(AC-USR-020-07/021-07)。
  -->
  <changeSet id="1.2.2-add-admin-account-status" author="aqua-rush">
    <preConditions onFail="MARK_RAN">
      <not>
        <columnExists tableName="admins" columnName="account_status"/>
      </not>
    </preConditions>

    <comment>Add account_status column to admins (account disable support)</comment>

    <addColumn tableName="admins">
      <column name="account_status" type="varchar(20)" defaultValue="ACTIVE">
        <constraints nullable="false"/>
      </column>
    </addColumn>
  </changeSet>

</databaseChangeLog>
