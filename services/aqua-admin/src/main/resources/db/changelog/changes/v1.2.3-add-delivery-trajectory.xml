<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
  xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
    http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.33.xsd">

  <!--
    配送轨迹表(PRD 05-address-delivery.md §F-ADR-012,R-ADR-03,G22 落地):
    送水工在订单「配送中」期间按设定频率(默认 5s)上报的实时位置点,
    delivery_worker_id 即账号 id(送水员档案并入 admins 单表,迁移 v1.2.1)。
  -->
  <changeSet id="1.2.3-add-delivery-trajectory" author="aqua-rush">
    <comment>Add delivery_trajectories table for real-time trajectory reporting</comment>

    <createTable tableName="delivery_trajectories">
      <column name="id" type="bigint">
        <constraints primaryKey="true" nullable="false"/>
      </column>
      <column name="delivery_worker_id" type="bigint">
        <constraints nullable="false"/>
      </column>
      <column name="order_id" type="bigint">
        <constraints nullable="false"/>
      </column>
      <column name="longitude" type="double">
        <constraints nullable="false"/>
      </column>
      <column name="latitude" type="double">
        <constraints nullable="false"/>
      </column>
      <column name="accuracy" type="double"/>
      <column name="reported_at" type="timestamp">
        <constraints nullable="false"/>
      </column>
      <column name="created_at" type="timestamp">
        <constraints nullable="false"/>
      </column>
    </createTable>

    <createIndex tableName="delivery_trajectories" indexName="idx_trajectory_worker_order">
      <column name="delivery_worker_id"/>
      <column name="order_id"/>
      <column name="reported_at"/>
    </createIndex>
    <createIndex tableName="delivery_trajectories" indexName="idx_trajectory_worker_reported">
      <column name="delivery_worker_id"/>
      <column name="reported_at"/>
    </createIndex>
    <createIndex tableName="delivery_trajectories" indexName="idx_trajectory_order">
      <column name="order_id"/>
    </createIndex>
  </changeSet>

</databaseChangeLog>
