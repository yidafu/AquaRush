# Aqua Admin GraphQL Schema
# Schema for the Admin dashboard and delivery worker management
# This is the main entry point that combines all module schemas

# Schema definition
schema {
  query: Query
  mutation: Mutation
}

# Root Query type - extended by modules
# (placeholder field required: graphql-js rejects empty type definitions)
type Query {
  _dummy: String
}

# Root Mutation type - extended by modules
# (placeholder field required: graphql-js rejects empty type definitions)
type Mutation {
  _dummy: String
}
