# AdminVO UserVO Management - AdminVO only

# 账号分页(参照 AddressVOPage/BannerVOPage 的新式分页)
type AdminVOPage {
  content: [AdminVO!]!
  totalElements: Int!
  totalPages: Int!
  size: Int!
  number: Int!
}

extend type Query {
  # AdminVO queries
  # 账号列表:分页 + keyword(username/realName/phone 模糊)。AGENTS.md 规则 10 禁止无界全量返回
  admins(keyword: String, role: String, page: Int = 0, size: Int = 20): AdminVOPage!
  # 账号详情(超管视图按 id 查,替代原「全量 admins 前端 find」)
  admin(id: PrimaryId!): AdminVO
}

extend type Mutation {
  # AdminVO mutations
  createAdmin(input: CreateAdminInput!): AdminVO!
  updateAdmin(id: PrimaryId!, input: UpdateAdminInput!): AdminVO!
  # 删除管理员(软删除;不能删除自己/最后一个超级管理员,G11 落地)
  deleteAdmin(id: PrimaryId!): Boolean!
  # 重置管理员密码(newPassword 留空则重置为默认密码 123456,G11 落地)
  resetAdminPassword(id: PrimaryId!, newPassword: String): Boolean!
}
