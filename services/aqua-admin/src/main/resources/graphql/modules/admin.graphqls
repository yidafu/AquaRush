# Admin User Management - Admin only

extend type Query {
  # Admin queries
  admins: [Admin!]!
}

extend type Mutation {
  # Admin mutations
  createAdmin(input: CreateAdminInput!): Admin!
  updateAdmin(id: PrimaryId!, input: UpdateAdminInput!): Admin!
  # 删除管理员(软删除;不能删除自己/最后一个超级管理员,G11 落地)
  deleteAdmin(id: PrimaryId!): Boolean!
  # 重置管理员密码(newPassword 留空则重置为默认密码 123456,G11 落地)
  resetAdminPassword(id: PrimaryId!, newPassword: String): Boolean!
}
