# Daily collection & reconciliation management
# 分页/筛选(AGENTS.md 规则 10 禁止全量查询):dailyCollections / dailyReconciliations
# 均返回分页结果;对账详情逐单明细(G29)经 dailyReconciliationOrderDetails 分页取回。
#
# 微信资金对账(F-ORD-031/R-PAY-04,G93;类型定义见 shared-types.graphqls §微信资金对账域):
# 对账任务/差异/报表查询与手动执行/差异处置(解决/忽略) mutation。
# 权限:查询 PAYMENT_RECONCILIATION_READ、执行与差异处置 PAYMENT_RECONCILIATION_EXECUTE
# (与 RECONCILIATION_* 送水工收款日报对账相互独立,见 spec/prd/01-overview.md §权限码目录)。

# 收款记录分页输入
input DailyCollectionListInput {
  # 收款日期(YYYY-MM-DD,可选)
  collectionDate: String
  # 送水工ID(可选)
  deliveryWorkerId: Long
  # 页码(从 0 开始)
  page: Int = 0
  # 每页条数
  size: Int = 10
}

# 对账记录分页输入
input DailyReconciliationListInput {
  # 页码(从 0 开始)
  page: Int = 0
  # 每页条数
  size: Int = 10
}

# 收款记录分页结果
type DailyCollectionVoPage {
  list: [DailyCollectionRecordVo!]!
  pageInfo: PageInfoVo!
}

# 对账记录分页结果
type DailyReconciliationVoPage {
  list: [DailyReconciliationVo!]!
  pageInfo: PageInfoVo!
}

# 指定日期收银汇总(后台顶部汇总卡)
type DailyCollectionSummaryVo {
  # 汇总日期
  collectionDate: String!
  # 现金收款合计(分,送水工填报)
  totalCashAmountCents: Long!
  # 扫码收款合计(分,送水工填报)
  totalQrCodeAmountCents: Long!
  # 水票数量合计(张,送水工填报)
  totalWaterTicketCount: Int!
  # 订单总数(系统计算)
  totalOrderCount: Int!
  # 订单金额合计(分,系统计算,含水票订单金额)
  totalOrderAmountCents: Long!
  # 已提交日报的送水工人数(草稿不计入)
  totalSubmittedCount: Int!
}

# 对账逐单明细(G29):当日「已送达」订单流水,与日报系统计算值同源
type ReconciliationOrderDetailVo {
  # 订单ID
  orderId: PrimaryId!
  # 订单号
  orderNo: String!
  # 送水工ID
  deliveryWorkerId: PrimaryId
  # 订单金额(分)
  amountCents: Long!
  # 收款方式(现金/水票/扫码)
  paymentType: PaymentType
  # 订单状态(待确认收货/已完成等)
  status: OrderStatus!
  # 送达时间(送达当场收款按此计入日报)
  deliveredAt: LocalDateTime
}

# 对账逐单明细分页结果
type ReconciliationOrderDetailVoPage {
  list: [ReconciliationOrderDetailVo!]!
  pageInfo: PageInfoVo!
}

extend type Query {
  # 每日收款分页查询(按收款日期/送水工筛选)
  dailyCollections(input: DailyCollectionListInput): DailyCollectionVoPage!
  # 对账记录分页查询(恒按对账日期倒序)
  dailyReconciliations(input: DailyReconciliationListInput): DailyReconciliationVoPage!
  # 指定日期收银汇总(默认今日)
  dailyCollectionSummary(collectionDate: String): DailyCollectionSummaryVo!
  # 对账逐单差异明细(G29:按对账日期分页返回当日已送达订单流水)
  dailyReconciliationOrderDetails(
    reconciliationDate: String!
    deliveryWorkerId: Long
    page: Int = 0
    size: Int = 20
  ): ReconciliationOrderDetailVoPage!
  # 配送员今日收款 - 获取今日收款预计算结果（订单统计）
  myTodayCollection: MyTodayCollectionVo

  # 微信资金对账:对账任务分页查询(类型/状态/对账日期范围筛选)
  reconciliationTasks(
    taskType: ReconciliationTaskType
    status: ReconciliationTaskStatus
    dateFrom: String
    dateTo: String
    page: Int = 0
    size: Int = 20
  ): ReconciliationTaskVoPage!
  # 对账任务详情
  reconciliationTask(taskId: String!): ReconciliationTaskVo
  # 对账差异分页查询(任务ID/差异类型/解决状态筛选)
  reconciliationDiscrepancies(
    taskId: String
    discrepancyType: DiscrepancyType
    status: DiscrepancyStatus
    page: Int = 0
    size: Int = 20
  ): ReconciliationDiscrepancyVoPage!
  # 对账报表列表(按任务,可选报表类型过滤)
  reconciliationReports(taskId: String!, reportType: String): [ReconciliationReportVo!]!
}

extend type Mutation {
  # 每日收款管理
  submitDailyCollection(input: SubmitDailyCollectionInput!): DailyCollectionRecordVo!
  confirmDailyCollection(input: ConfirmDailyCollectionInput!): DailyCollectionRecordVo!
  rejectDailyCollection(input: RejectDailyCollectionInput!): DailyCollectionRecordVo!
  reviewReconciliation(input: ReviewReconciliationInput!): DailyReconciliationVo!
  executeDailyReconciliation(reconciliationDate: String): DailyReconciliationVo!

  # 微信资金对账:手动执行对账(创建任务并异步执行;账单日限 T-1~T-30,R-PAY-04)
  executeReconciliation(input: ExecuteReconciliationInput!): ReconciliationTaskVo!
  # 差异处置(解决/忽略,备注必填留痕;已处置不可再改)
  resolveDiscrepancy(input: ResolveDiscrepancyInput!): Boolean!
}
