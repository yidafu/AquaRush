# Product management (Admin)

extend type Query {
  # Product queries
  product(id: PrimaryId!): Product
  productStatistics(dateRange: DateRangeInput): ProductStatistics
  productDailySales(input: DateRangeInput!): [ProductDailySales!]!
  productsPaginated(input: ProductSearchInput): ProductVOPage
  activeProducts(keyword: String, page: Int = 0, size: Int = 20): ProductVOPage!
  # 库存预警阈值(商品列表着色/低库存判断用,读系统参数 F-SYS-003,缺省 10/50)
  stockWarningThresholds: StockWarningThresholds!
  # 用户收藏的商品(用户详情页「收藏商品」Tab,分页)
  favoriteProducts(userId: PrimaryId!, page: Int = 0, size: Int = 20): FavoriteProductVOPage!
}

# 库存预警阈值(低库存红 < lowThreshold,中档橙 < midThreshold,其余绿;R-PRO-02)
type StockWarningThresholds {
  # 低库存阈值(件)
  lowThreshold: Int!
  # 中档预警阈值(件,须大于 lowThreshold)
  midThreshold: Int!
}

extend type Mutation {
  # Product mutations
  createProduct(input: CreateProductInput!): Product!
  updateProduct(id: PrimaryId!, input: UpdateProductInput!): Product!
  deleteProduct(id: PrimaryId!): Boolean!
  updateProductStatus(productId: PrimaryId!, status: ProductStatus!): Product!
  onlineProduct(id: PrimaryId!): Product!
  offlineProduct(id: PrimaryId!): Product!
}
