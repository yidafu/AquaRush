# ProductVo management (AdminVo)

extend type Query {
  # ProductVo queries
  product(id: PrimaryId!): ProductVo
  productStatistics(dateRange: DateRangeInput): ProductStatisticsVo
  productDailySales(input: DateRangeInput!): [ProductDailySalesVo!]!
  productsPaginated(input: ProductSearchInput): ProductVoPage
  activeProducts(keyword: String, page: Int = 0, size: Int = 20): ProductVoPage!
  # 库存预警阈值(商品列表着色/低库存判断用,读系统参数 F-SYS-003,缺省 10/50)
  stockWarningThresholds: StockWarningThresholdsVo!
  # 用户收藏的商品(用户详情页「收藏商品」Tab,分页)
  favoriteProducts(userId: PrimaryId!, page: Int = 0, size: Int = 20): FavoriteProductVoPage!
  # 商品属性选项字典(F-PRO-009):规格/水源地下拉选项;enabledOnly=true 仅返回启用项(商品表单用),false 返回全量(配置页用)
  productOptions(type: ProductOptionType!, enabledOnly: Boolean = false): [ProductOptionVo!]!
}

# 商品属性选项字典(F-PRO-009):规格/水源地下拉选项的配置来源,替换前端硬编码候选
type ProductOptionVo {
  id: PrimaryId!
  optionType: ProductOptionType!
  # 选项值(如规格 "500ml"/"19L",水源地 "长白山")
  value: String!
  # 排序号(同类型内升序展示)
  sortOrder: Int!
  # 是否启用(禁用项不在商品表单下拉中展示)
  enabled: Boolean!
  createdAt: LocalDateTime!
  updatedAt: LocalDateTime!
}

# 商品属性选项类型(F-PRO-009)
enum ProductOptionType {
  # 商品规格
  SPECIFICATION
  # 水源地
  WATER_SOURCE
}

# 库存预警阈值(低库存红 < lowThreshold,中档橙 < midThreshold,其余绿;R-PRO-02)
type StockWarningThresholdsVo {
  # 低库存阈值(件)
  lowThreshold: Int!
  # 中档预警阈值(件,须大于 lowThreshold)
  midThreshold: Int!
}

extend type Mutation {
  # ProductVo mutations
  createProduct(input: CreateProductInput!): ProductVo!
  updateProduct(id: PrimaryId!, input: UpdateProductInput!): ProductVo!
  deleteProduct(id: PrimaryId!): Boolean!
  updateProductStatus(productId: PrimaryId!, status: ProductStatus!): ProductVo!
  onlineProduct(id: PrimaryId!): ProductVo!
  offlineProduct(id: PrimaryId!): ProductVo!
  # 商品属性选项字典(F-PRO-009)
  createProductOption(input: CreateProductOptionInput!): ProductOptionVo!
  updateProductOption(id: PrimaryId!, input: UpdateProductOptionInput!): ProductOptionVo!
  deleteProductOption(id: PrimaryId!): Boolean!
}

# 商品属性选项新建入参(F-PRO-009)
input CreateProductOptionInput {
  optionType: ProductOptionType!
  # 选项值(1-100 字符,同类型内唯一)
  value: String!
    @notBlank(message: "选项值不能为空")
    @size(min: 1, max: 100, message: "选项值长度应在1-100个字符之间")
  # 排序号(缺省=同类型末尾)
  sortOrder: Int @min(value: 0, message: "排序号不能小于0")
  # 是否启用(缺省 true)
  enabled: Boolean = true
}

# 商品属性选项更新入参(F-PRO-009)
input UpdateProductOptionInput {
  value: String!
    @notBlank(message: "选项值不能为空")
    @size(min: 1, max: 100, message: "选项值长度应在1-100个字符之间")
  sortOrder: Int @min(value: 0, message: "排序号不能小于0")
  enabled: Boolean = true
}
