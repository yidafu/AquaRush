# 水桶押金管理(B2 押金模型回退,PRD R-MON-03/R-PRO-05/F-PRO-012 与 14-misc §G06):
# 押金价目(按规格,与商品解耦)+ 押金记录 + 空桶回收与退押确认 + 桶账台账;
# 原 G06 一次性购桶费 API(barrelFees/barrelPurchases/refundBarrelPurchase)已废弃,
# barrel_purchases 历史数据保留不 drop,支付回调 BK 单号链路保留兼容。

# 押金价目状态(R-MON-03:押金 0~99999 元按规格配置)
enum DepositPriceStatus {
  ENABLED # 启用(下单按此规格收押)
  DISABLED # 停用(新订单不再收取,已收押金不受影响)
}

# 水桶押金价目(按规格,与商品解耦)
type DepositPriceVo {
  id: PrimaryId!
  # 规格(唯一,如 19L/5L)
  specification: String!
  # 押金(分,0..9999900)
  depositCents: Long!
  status: DepositPriceStatus!
  # 排序权重(升序)
  sortOrder: Int!
  createdAt: LocalDateTime!
  updatedAt: LocalDateTime!
}

type DepositPriceVoPage {
  content: [DepositPriceVo!]!
  totalElements: Int!
  totalPages: Int!
  size: Int!
  number: Int!
}

# 押金记录分页(后台押金管理「押金记录」Tab)
type DepositRecordVoPage {
  content: [DepositRecordVo!]!
  totalElements: Int!
  totalPages: Int!
  size: Int!
  number: Int!
}

input DepositPriceListInput {
  status: DepositPriceStatus
  keyword: String
  page: Int = 0
  size: Int = 20
}

# 押金价目新增/编辑合一(设计 02 §5.1 upsertDepositPrice;id 空=新增,规格唯一冲突拦截)
input UpsertDepositPriceInput {
  id: PrimaryId
  specification: String! @notBlank(message: "规格不能为空") @size(max: 100, message: "规格不能超过100个字符")
  depositCents: Long!
    @min(value: 0, message: "押金不能小于0")
    @max(value: 9999900, message: "押金不能大于99999元")
  status: DepositPriceStatus = ENABLED
  sortOrder: Int @min(value: 0, message: "排序权重不能小于0") @max(value: 9999, message: "排序权重不能大于9999")
}

input DepositRecordListInput {
  userId: PrimaryId
  status: DepositStatus
  specification: String
  page: Int = 0
  size: Int = 20
}

# 桶账台账行(R-PRO-05/F-PRO-012:按客户维度实时聚合,在租/欠桶/押金合计)
type BarrelLedgerRowVo {
  userId: PrimaryId!
  nickname: String
  phone: String
  # 在租押金桶数(HELD)
  heldBucketCount: Int!
  # 押金合计(在租,分)
  depositHeldCents: Long!
  # 已退押金(分,REFUNDED 累计)
  depositRefundedCents: Long!
  # 已交付桶数(已完成订单 items,押金价目规格)
  deliveredBucketCount: Int!
  # 已回收空桶数
  recoveredBucketCount: Int!
  # 欠桶数 = 已交付 − 已回收
  owedBucketCount: Int!
}

type BarrelLedgerVoPage {
  content: [BarrelLedgerRowVo!]!
  totalElements: Int!
  totalPages: Int!
  size: Int!
  number: Int!
}

input BarrelLedgerInput {
  # 关键词(昵称/手机号模糊)
  keyword: String
  # 仅看有欠桶
  onlyOwed: Boolean = false
  page: Int = 0
  size: Int = 20
}

extend type Query {
  # 押金价目分页(状态/关键词筛选;PERMISSION_PRODUCT_READ)
  depositPrices(input: DepositPriceListInput): DepositPriceVoPage!
  # 押金记录分页(用户/状态/规格筛选;PERMISSION_PRODUCT_READ)
  depositRecords(input: DepositRecordListInput): DepositRecordVoPage!
  # 退押申请分页(状态筛选;PERMISSION_PRODUCT_READ;与用户端同签名以合并 schema)
  depositRefundApplications(status: DepositRefundApplicationStatus, page: Int = 0, size: Int = 20): DepositRefundApplicationVoPage!
  # 桶账台账(按客户实时聚合,筛选含「有欠桶」;PERMISSION_PRODUCT_READ,F-PRO-012)
  # 注:导出 exportBarrelLedger 依赖 export_tasks 异步导出基建(G20 排期),暂未提供
  barrelLedger(input: BarrelLedgerInput): BarrelLedgerVoPage!
}

extend type Mutation {
  # 押金价目新增/编辑(id 空=新增,规格唯一;PERMISSION_PRODUCT_WRITE)
  upsertDepositPrice(input: UpsertDepositPriceInput!): DepositPriceVo!
  # 空桶回收确认(PENDING→RECOVERED;PERMISSION_PRODUCT_WRITE,R-PRO-04)
  confirmBarrelRecovered(applicationId: PrimaryId!): DepositRefundApplicationVo!
  # 退押审核通过(RECOVERED→REFUNDED:执行微信退款 DEPOSIT_REFUND 独立账本 + 押金记录 HELD→REFUNDED;
  # PERMISSION_PRODUCT_WRITE,R-PRO-04/R-MON-03)
  approveDepositRefund(applicationId: PrimaryId!): DepositRefundApplicationVo!
  # 退押驳回(PENDING/RECOVERED→REJECTED,留原因;PERMISSION_PRODUCT_WRITE)
  rejectDepositRefund(applicationId: PrimaryId!, reason: String!): DepositRefundApplicationVo!
}
