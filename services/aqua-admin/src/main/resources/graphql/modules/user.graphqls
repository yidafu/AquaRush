# UserVo management - AdminVo only

extend type Query {
  # UserVo queries
  users(input: UserListInput): UserVoPage!
  user(id: PrimaryId!): UserVo
}

extend type Mutation {
  # 后台创建用户(F-USR-022,G11 落地;wechatOpenId 自动生成占位)
  createUser(input: CreateUserInput!): UserVo!
  # 后台编辑用户(昵称/手机号/头像/状态)
  updateUser(id: PrimaryId!, input: UpdateUserInput!): UserVo!
  # 后台删除用户(软删除)
  deleteUser(id: PrimaryId!): Boolean!
}
