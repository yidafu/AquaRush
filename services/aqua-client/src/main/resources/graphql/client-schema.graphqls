# Aqua Client GraphQL Schema
# Schema for the WeChat Mini Program client application

# Extend shared schema
# The shared types are imported from shared-config/graphql/shared-types.graphqls

# Schema definition
schema {
  query: Query
  mutation: Mutation
}

# Client-specific Query Schema
type Query {
  # Authentication
  me: UserInfo

  # Addresses
  address(id: PrimaryId!): Address

  # Enhanced Address Management
  userAddresses: [Address!]!

  # Regions
  regions(level: Int, parentCode: String): [Region!]!
  region(code: String!): Region

  # Products
  activeProducts(keyword: String, page: Int = 0, size: Int = 20, sortBy: String = "createdAt", sortDirection: String = "desc"): ProductVOPage!
  product(id: PrimaryId!): Product

  # Favorites queries
  favoriteProducts(page: Int = 0, size: Int = 20): FavoriteProductVOPage!
  isProductFavorited(productId: PrimaryId!): Boolean!
  favoritesCount: Long!

  # Operations config queries (运营配置域 F-OPS-001)
  activeBanners: [Banner!]!

}

# Client-specific Mutation Schema
type Mutation {
  # Authentication
  updateProfile(input: UpdateProfileInput!): UserInfo!

  # Addresses
  createAddress(input: AddressInput!): Address!
  updateAddress(id: PrimaryId!, input: UpdateAddressInput!): Address!
  deleteAddress(id: PrimaryId!): Boolean!
  setDefaultAddress(id: PrimaryId!): Boolean!

  # Orders
  createOrder(input: CreateOrderInput!): Order!


  # Favorites mutations
  toggleProductFavorites(productId: PrimaryId!): Boolean!

  # Operations config mutations (意见反馈提交, F-USR-005)
  submitFeedback(input: FeedbackSubmitInput!): Boolean!
}

# 反馈提交输入
input FeedbackSubmitInput {
  # 反馈类型
  feedbackType: FeedbackType!
  # 反馈内容(10~500字)
  content: String! @notBlank @size(min: 10, max: 500)
  # 图片地址数组(≤3张,平台存储服务上传后回传)
  images: [String!]
  # 联系方式(可选)
  contactInfo: String @size(max: 100)
}

